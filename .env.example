# =============================================
# TRIVO ERP - Environment Configuration
# =============================================

# Server
NODE_ENV=development
PORT=3001
# Behind a reverse proxy (nginx) set TRUST_PROXY=1 so rate limits are per real client, not per proxy. Unset when exposed directly.
# TRUST_PROXY=1
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL) — TRIVO runs on THREE database identities (see server/prisma/production-rls-roles.sql):
#   DATABASE_URL           the APP role (trivo_runtime): no table ownership, no BYPASSRLS. Row-level security is
#                          enforced against it, so a query that forgets a company filter still returns nothing.
#   PLATFORM_DATABASE_URL  the PLATFORM role (trivo_platform): BYPASSRLS, DML only. Used ONLY for provisioning,
#                          operator actions, platform audit and start-up device enumeration. Unset = falls back to
#                          DATABASE_URL (fine for a single-role dev database, refused in production).
#   OWNER_DATABASE_URL     the OWNER role (trivo_owner): DDL. Used by migrations / db-secure only — never by the API.
# In development one superuser-ish role for all three is fine (RLS is then inert and the tests say so).
# connection_limit: max simultaneous DB connections per server process
# pool_timeout:     seconds to wait for a connection before throwing (prevents silent hangs)
# connect_timeout:  seconds for initial TCP handshake (catches dead DB host quickly)
# For a remote database add sslmode=require (or verify-full with sslrootcert=...) to every URL.
DATABASE_URL="postgresql://sea_erp:sea_erp_pass@localhost:5432/sea_erp_db?schema=public&connection_limit=20&pool_timeout=10&connect_timeout=5"
# PLATFORM_DATABASE_URL="postgresql://trivo_platform:CHANGE_ME@localhost:5432/sea_erp_db?schema=public&connection_limit=5&pool_timeout=10&connect_timeout=5"
# OWNER_DATABASE_URL="postgresql://trivo_owner:CHANGE_ME@localhost:5432/sea_erp_db?schema=public"

# Operator API key for POST /api/v1/platform/* (create a company). Unset = the platform API is disabled (404).
# At least 32 random characters, e.g. `openssl rand -base64 48`. This is an OPERATOR credential — never a tenant one.
# TRIVO_PLATFORM_API_KEY=

# Redis (Caching & Sessions)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# File Storage (MinIO / S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=sea-erp-files
MINIO_USE_SSL=false

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=erp@yourcompany.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="SEA ERP <erp@yourcompany.com>"

# SMS Gateway
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=SEAERP

# Metal Rate API
METAL_RATE_API_URL=https://api.metalpriceapi.com/v1
METAL_RATE_API_KEY=your-metal-rate-api-key

# (Company name / GSTIN / address / state are per-company data on the Company row — not environment variables.)

# (Scales / RFID readers are company-owned HardwareDevice rows — not environment variables.)
