# ── SEA ERP Client Environment ──────────────────────────────────────────────
# Vite ONLY exposes variables prefixed with VITE_ to the browser bundle.
# Variables without this prefix are stripped at build time and will be undefined.

# Leave empty for local dev — the Vite proxy in vite.config.ts rewrites
# /api requests to http://localhost:3001 automatically.
VITE_API_URL=

# Set this to your deployed backend for staging/production builds:
# VITE_API_URL=https://erp.yourcompany.com

# WebSocket URL (only needed when running client standalone without Vite proxy)
# VITE_WS_URL=https://erp.yourcompany.com
