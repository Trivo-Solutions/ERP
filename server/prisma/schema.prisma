datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ═══════════════════════════════════════════════════
// SYSTEM / SHARED
// ═══════════════════════════════════════════════════

// ═══════════════════════════════════════════════════
// MULTI-TENANCY — Platform / Company / Branch / Membership
// ═══════════════════════════════════════════════════
//
// Prototype scope (see CLAUDE.md multi-tenant blueprint): Company, CompanyUser, Branch,
// UserBranchAccess, Role, Client, JewelryTag, SalesInvoice, InvoiceItem, NumberSequence.
// Every other model still carries no companyId yet — that is Phase J, not this migration.

// A company's own copy of a role — always company-owned, never global. The role definitions themselves
// come from the versioned TRIVO Starter Package (modules/platform/starterPackage) and are COPIED into
// each company at provisioning; later package versions never change an existing company's roles.
// Reached only through
// CompanyUser (a User has no direct roleId — see User below); this is what "company membership
// is represented through CompanyUser" means for permissions specifically.
model Role {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id])
  name        String
  displayName String
  permissions String[]
  memberships CompanyUser[]
  invitations CompanyInvitation[]
  createdAt   DateTime            @default(now())

  @@unique([companyId, name])
  // composite-FK target: lets the database refuse a child that points at another company's Role
  @@unique([id, companyId])
  @@index([companyId])
  @@map("roles")
}

// The root of the tenant hierarchy. code is the "Company Code" half of the
// Company Code + Username/Email + Password login. Seeded values (name/gstin/stateCode/
// defaultCurrency) replace the old singleton SystemConfig COMPANY_* rows for this data.
model Company {
  id                      String    @id @default(cuid())
  code                    String    @unique
  name                    String
  gstin                   String?
  stateCode               String?
  address                 String?
  defaultCurrency         String    @default("INR")
  // The TRIVO Starter Package version this company was provisioned with (NULL = predates starter
  // packages, e.g. the original SEA company). Recorded once at provisioning; a newer package version
  // never changes an existing company — updates would be an explicit, separate action.
  starterPackageVersion   Int?
  starterPackageAppliedAt DateTime?
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  branches                  Branch[]
  companyUsers              CompanyUser[]
  roles                     Role[]
  clients                   Client[]
  jewelryTags               JewelryTag[]
  salesInvoices             SalesInvoice[]
  invoiceItems              InvoiceItem[]
  numberSequences           NumberSequence[]
  oldGoldExchanges          OldGoldExchange[]
  memoOuts                  MemoOut[]
  memoItems                 MemoItem[]
  stockAudits               StockAudit[]
  branchTransfers           BranchTransfer[]
  tagTemplates              TagTemplate[]
  invoicePayments           InvoicePayment[]
  salesReturns              SalesReturn[]
  repairCases               RepairCase[]
  repairTransfers           RepairTransfer[]
  repairTransferItems       RepairTransferItem[]
  tagRetags                 TagRetag[]
  accounts                  Account[]
  journalEntries            JournalEntry[]
  journalLines              JournalLine[]
  costCenters               CostCenter[]
  auditLogs                 AuditLog[]
  tagHistory                TagHistory[]
  purchaseReturns           PurchaseReturn[]
  supplierPayments          SupplierPayment[]
  purchaseLots              PurchaseLot[]
  poItemCategories          PoItemCategory[]
  vendorComponentRates      VendorComponentRate[]
  poItemComponents          PoItemComponent[]
  grnItemComponentRates     GrnItemComponentRate[]
  purchaseReturnItems       PurchaseReturnItem[]
  purchaseOrders            PurchaseOrder[]
  poItems                   PoItem[]
  goodsReceiptNotes         GoodsReceiptNote[]
  grnItems                  GrnItem[]
  purchaseRequisitions      PurchaseRequisition[]
  prItems                   PrItem[]
  approvalHistory           ApprovalHistory[]
  hallmarkingBatches        HallmarkingBatch[]
  hallmarkingItems          HallmarkingItem[]
  repairJobs                RepairJob[]
  repairTransactions        RepairTransaction[]
  designs                   Design[]
  designFiles               DesignFile[]
  bomItems                  BomItem[]
  bomProcesses              BomProcess[]
  costEstimates             CostEstimate[]
  suppliers                 Supplier[]
  metalStocks               MetalStock[]
  metalStockMovements       MetalStockMovement[]
  stoneLots                 StoneLot[]
  stoneLotSplits            StoneLotSplit[]
  consumables               Consumable[]
  consumableTxns            ConsumableTransaction[]
  salesOrders               SalesOrder[]
  orderItems                OrderItem[]
  materialReservations      MaterialReservation[]
  clientNotifications       ClientNotification[]
  jobCards                  JobCard[]
  jobProcesses              JobProcess[]
  wipTracking               WipTracking[]
  qcCheckpoints             QcCheckpoint[]
  artisans                  Artisan[]
  karigarLedgers            KarigarLedger[]
  processTolerances         ProcessTolerance[]
  subcontractorInvoices     SubcontractorInvoice[]
  hardwareDevices           HardwareDevice[]
  metalRates                MetalRate[]
  priceMasters              PriceMaster[]
  jewelryTagMaterials       JewelryTagMaterial[]
  makingCharges             MakingCharge[]
  tagEstimates              TagEstimate[]
  tagEstimateItems          TagEstimateItem[]
  estimateTemplates         EstimateTemplate[]
  stockAuditItems           StockAuditItem[]
  branchTransferItems       BranchTransferItem[]
  salesReturnItems          SalesReturnItem[]
  exportDocuments           ExportDocument[]
  taxInvoices               TaxInvoice[]
  systemConfigs             SystemConfig[]
  userBranchAccess          UserBranchAccess[]
  companyInvitations        CompanyInvitation[]
  designCategories          DesignCategory[]
  karatMasters              KaratMaster[]
  productCategories         ProductCategory[]
  subCategories             SubCategory[]
  categorySubCategories     CategorySubCategory[]
  collections               Collection[]
  sizes                     Size[]
  settingTypes              SettingType[]
  materialCodes             MaterialCode[]
  stockTypes                StockType[]
  stoneTypes                StoneType[]
  stoneGrades               StoneGrade[]
  gstRegistrations          CompanyGstRegistration[]
  taxInvoiceTemplates       TaxInvoiceTemplate[]
  // G2a
  creditNotes               CreditNote[]
  creditNoteItems           CreditNoteItem[]
  debitNotes                DebitNote[]
  debitNoteItems            DebitNoteItem[]
  // G2g-4b — Sales (outward) Debit Note. Wholly separate from the procurement-side DebitNote above.
  salesDebitNotes           SalesDebitNote[]
  // G2g-7d — inward RCM foundation.
  rcmLiabilities            RcmLiability[]
  selfInvoices              SelfInvoice[]
  salesDebitNoteItems       SalesDebitNoteItem[]
  creditNoteTemplates       CreditNoteTemplate[]
  debitNoteTemplates        DebitNoteTemplate[]
  // Phase D: GST AATO
  gstAatos                  CompanyGstAato[]
  gstAatoHistories          CompanyGstAatoHistory[]
  // G2g-6a: statutory filing-period persistence foundation (schema + RLS only — no builder/filing
  // service exists yet; see GstReturnPeriod's own comment).
  gstReturnPeriods          GstReturnPeriod[]
  gstFilingSnapshots        GstFilingSnapshot[]
  gstFilingAttempts         GstFilingAttempt[]
  // G2g-7e: GSTR-2B ingestion.
  gst2bStatements           Gst2bStatement[]
  gst2bDocuments            Gst2bDocument[]
  // G8a: GST integration foundation.
  gstIntegrationConfigs     GstIntegrationConfig[]
  gstIntegrationCredentials GstIntegrationCredential[]
  gstIntegrationRequestLogs GstIntegrationRequestLog[]
  eInvoiceRecords           EInvoiceRecord[]

  @@map("companies")
}

// G1: a company's GST registration(s). Company.gstin/stateCode (above) remain as the legacy,
// single-registration fields — kept for backwards compatibility, never removed in this phase —
// but the authoritative, extensible source going forward is this table. Every existing company
// gets exactly one row here at migration time (backfilled from Company.gstin/stateCode),
// isPrimary=true, so nothing that already worked stops working. A company that only ever needs
// one GSTIN can ignore this model entirely; nothing requires more than one row.
model CompanyGstRegistration {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  gstin     String
  legalName String
  tradeName String?
  stateCode String
  address   String?
  city      String?
  district  String?
  pincode   String?
  country   String   @default("India")
  // Only one row per company may be both isPrimary and isActive — enforced in the service layer
  // (gstRegistration.service.ts), the same "uniqueness invariant enforced in a transaction, not a
  // DB constraint" precedent as TagTemplate/EstimateTemplate's isDefault.
  isPrimary Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches           Branch[]
  // Phase D: AATO records for this registration
  aatoRecords        CompanyGstAato[]
  aatoHistories      CompanyGstAatoHistory[]
  // G2g-6a: every statutory return period filed under this registration.
  returnPeriods      GstReturnPeriod[]
  // G2g-7a: every inward GRN line attributed to this registration as the buyer.
  buyerGrnItems      GrnItem[]
  // G2g-7d: inward RCM foundation.
  rcmLiabilities     RcmLiability[]
  selfInvoices       SelfInvoice[]
  // G2g-7e: every GSTR-2B statement imported for this registration.
  gst2bStatements    Gst2bStatement[]
  // G8a: every GST integration config (provider × environment) scoped to this registration.
  integrationConfigs GstIntegrationConfig[]
  // G8c: e-invoice (IRN) operation records issued under this registration.
  eInvoiceRecords    EInvoiceRecord[]

  @@unique([companyId, gstin])
  // composite-FK target: lets the database refuse a Branch pointing at another company's registration
  @@unique([id, companyId])
  @@index([companyId])
  @@map("company_gst_registrations")
}

// Phase D — GST AATO (Annual Aggregate Turnover) management. Associated with Company -> GST Registration -> Financial Year.
// Reuses the existing company/GST-registration architecture.
model CompanyGstAato {
  id                 String                 @id @default(cuid())
  companyId          String
  company            Company                @relation(fields: [companyId], references: [id])
  gstRegistrationId  String
  gstRegistration    CompanyGstRegistration @relation(fields: [gstRegistrationId], references: [id])
  financialYear      String // Indian FY format "YYYY-YY", e.g. "2024-25"
  turnover           Decimal                @db.Decimal(15, 2)
  precedingTurnover  Decimal?               @db.Decimal(15, 2)
  source             String                 @default("MANUAL") // MANUAL | GST_PORTAL | IMPORT | SYSTEM_CALCULATED | OTHER
  verificationStatus String                 @default("UNVERIFIED") // UNVERIFIED | VERIFIED
  verifiedDate       DateTime?
  verifiedBy         String?
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  histories CompanyGstAatoHistory[]

  @@unique([companyId, gstRegistrationId, financialYear])
  @@unique([id, companyId])
  @@index([companyId])
  @@index([gstRegistrationId])
  @@map("company_gst_aatos")
}

// Phase D — GST AATO History. Records all creations, updates, and verification status transitions for auditability.
model CompanyGstAatoHistory {
  id                 String                 @id @default(cuid())
  companyId          String
  company            Company                @relation(fields: [companyId], references: [id])
  aatoId             String
  aato               CompanyGstAato         @relation(fields: [aatoId], references: [id], onDelete: Cascade)
  gstRegistrationId  String
  gstRegistration    CompanyGstRegistration @relation(fields: [gstRegistrationId], references: [id])
  financialYear      String
  turnover           Decimal                @db.Decimal(15, 2)
  precedingTurnover  Decimal?               @db.Decimal(15, 2)
  source             String
  verificationStatus String
  verifiedDate       DateTime?
  notes              String?
  action             String // CREATE | UPDATE | VERIFY
  changedBy          String?
  createdAt          DateTime               @default(now())

  @@index([companyId])
  @@index([aatoId])
  @@index([gstRegistrationId, financialYear])
  @@map("company_gst_aato_histories")
}

// G2g-6a — statutory filing-period PERSISTENCE FOUNDATION (schema + RLS + permissions), since built
// out by G2g-6b (snapshot builder, gstr1FilingSnapshot.service.ts), G2g-6c (filing-attempt history,
// gstr1FilingAttempt.service.ts), G2g-6d (mutation guard, gstr1FilingProtection.ts), and G2g-6e (the
// authoritative FILED/LOCKED transition, gstr1FilingPeriod.service.ts) — see CLAUDE.md's entries for
// each. The approved architecture:
//
//   Company -> CompanyGstRegistration -> GstReturnPeriod -> { GstFilingSnapshot, GstFilingAttempt }
//
// There is deliberately NO separate "GstPeriodLock" model — GstReturnPeriod itself owns the
// lifecycle/status and the filing/lock metadata below. Only GSTR1 is supported today; returnType
// stays a plain String (this codebase's convention for every other status/type field, e.g.
// SalesInvoice.invoiceType, PurchaseOrder.poType) so GSTR3B/GSTR1A can be added later without a
// schema change, never implemented now.
model GstReturnPeriod {
  id                String                 @id @default(cuid())
  companyId         String
  company           Company                @relation(fields: [companyId], references: [id])
  gstRegistrationId String
  // Composite FK (CLAUDE.md §11 item 6): the database itself refuses a return period pointing at
  // another company's GST registration — never inferred/silently populated.
  gstRegistration   CompanyGstRegistration @relation(fields: [gstRegistrationId, companyId], references: [id, companyId])

  // Only "GSTR1" is supported in this phase. Do not add GSTR3B/GSTR1A handling without a deliberate
  // follow-up phase (see CLAUDE.md).
  returnType    String
  // Indian FY convention used throughout the GST module ("YYYY-YY", e.g. "2026-27") — matches
  // CompanyGstAato.financialYear and shared/financialYear.ts: getFinancialYearForDate(), the only
  // other per-registration, FY-keyed model/helper in this codebase.
  financialYear String
  // MMYYYY, matching the existing GSTR-1 export convention exactly (gstr1Export.service.ts:
  // resolveFilingPeriodMmYYYY / Gstr1GstnExportDto.metadata.period.filingPeriodMmYYYY), e.g. "092026".
  taxPeriod     String

  // Lifecycle: OPEN -> SNAPSHOT_CREATED -> FILING_ATTEMPTED -> FILED -> LOCKED. SNAPSHOT_CREATED does
  // NOT mean locked. G2g-6e implements the FILED and LOCKED transitions (gstr1FilingPeriod.service.ts)
  // — FILING_ATTEMPTED is set by G2g-6c's createGstr1FilingAttempt when the period is still OPEN/
  // SNAPSHOT_CREATED (an attempt has been made but not yet resolved); FILED/LOCKED are the only
  // authoritative, permanent boundary — see that file's own header for the full transition rules.
  status String @default("OPEN")

  // Filing metadata. filedAt/filedSnapshotId/arn predate G2g-6e (G2g-6a's own placeholder columns);
  // filedById/filedByAttemptId/lockedAt/lockedById are new in G2g-6e. All remain null until
  // gstr1FilingPeriod.service.ts's controlled FILED/LOCKED transitions set them — never written by
  // any other code path.
  filedAt          DateTime?
  filedSnapshotId  String?
  // Named relation: distinct from GstFilingSnapshot.returnPeriod below (a snapshot's own parent) —
  // this is "which exact snapshot, among this period's possibly several, was the one actually filed".
  filedSnapshot    GstFilingSnapshot? @relation("GstReturnPeriodFiledSnapshot", fields: [filedSnapshotId, companyId], references: [id, companyId])
  // G2g-6e: the exact ACCEPTED GstFilingAttempt whose eligibility established this FILED boundary —
  // "FILED stores correct attempt association" (brief §5). Composite FK: the database refuses this
  // pointing at another company's attempt. RESTRICT — an attempt that established a filing boundary
  // is never deletable out from under it (attempts are append-only everywhere in this codebase anyway).
  filedByAttemptId String?
  filedByAttempt   GstFilingAttempt?  @relation("GstReturnPeriodFiledAttempt", fields: [filedByAttemptId, companyId], references: [id, companyId])
  // Actor who performed the controlled FILED transition — distinct from GstFilingAttempt.createdById
  // (who recorded the attempt/outcome, a possibly earlier and different step).
  filedById        String?
  filedBy          User?              @relation("GstReturnPeriodFiledBy", fields: [filedById], references: [id])
  // Real, externally-issued GST ARN once filed. Never generated or validated by this system.
  arn              String?

  // G2g-6e: LOCKED is a separate, later, one-way transition from FILED (brief §13) — never combined
  // with the filedAt/filedById pair above, so a period's filed-vs-locked moments stay independently
  // auditable even though LOCKED can only ever follow FILED.
  lockedAt   DateTime?
  lockedById String?
  lockedBy   User?     @relation("GstReturnPeriodLockedBy", fields: [lockedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots      GstFilingSnapshot[] @relation("GstFilingSnapshotReturnPeriod")
  filingAttempts GstFilingAttempt[]

  // A GST registration cannot have two periods for the same return type + FY + tax period. Two
  // DIFFERENT registrations (even in the same company) may legitimately share one, same reasoning
  // as every other registration-scoped uniqueness constraint in this schema (CreditNote,
  // SalesDebitNote numbering).
  // Explicitly named: the unhashed default exceeds Postgres's 63-byte identifier limit and gets
  // silently truncated (same issue CreditNote.creditNoteNumber's own constraint documents).
  @@unique([companyId, gstRegistrationId, returnType, financialYear, taxPeriod], map: "gst_return_periods_company_registration_period_key")
  // composite-FK target: lets the database refuse a child (snapshot/attempt) pointing at another
  // company's return period.
  @@unique([id, companyId])
  @@index([companyId])
  @@index([gstRegistrationId])
  @@map("gst_return_periods")
}

// A historical, immutable representation of one filing attempt's exact payload (or payload-in-
// waiting) for a GstReturnPeriod. Deliberately NOT built/populated by any service in this phase —
// see the model-level fields below, each annotated with what G2g-6b/6c will eventually compute.
model GstFilingSnapshot {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  returnPeriodId String
  returnPeriod   GstReturnPeriod @relation("GstFilingSnapshotReturnPeriod", fields: [returnPeriodId, companyId], references: [id, companyId])

  // Identifies snapshot #1, #2, #3, ... for this return period. Allocation logic (e.g. "next
  // version number") is NOT implemented in this phase — that belongs to G2g-6b.
  version Int

  // Eventually the canonical GSTR-1 export DTO (with diagnostics/traceability) and the exact
  // GSTN-facing serialized payload, respectively. No snapshot builder exists yet — nothing writes
  // these in this phase; buildGstr1GstnExport()/the serializer are NOT called from here.
  canonicalDtoJson Json
  wireJson         Json

  // Eventually SHA-256 of the canonical DTO / the exact serialized wire payload bytes. No hashing
  // implementation exists in this phase — schema only persists the eventual value.
  canonicalDtoHash String
  wireJsonHash     String

  // Which serializer/adapter implementation produced this snapshot, for traceability as those
  // evolve. gstnSchemaVersion may legitimately stay "UNSPECIFIED" until a real GSTN schema version
  // is adopted — never invented here.
  serializerVersion String
  adapterVersion    String
  gstnSchemaVersion String @default("UNSPECIFIED")

  // Denormalized snapshot metadata — the exact date range this snapshot represents, preserved even
  // if the report range convention changes later.
  periodFrom DateTime
  periodTo   DateTime

  // Full registration scope vs a specific branch — preserved historically even if branch
  // permissions change later. No branch-scope validation is implemented in this phase.
  branchScope Json

  // Eventually the complete Gstr1GstnValidationResult (blockers + warnings) for this snapshot. The
  // validator is NOT invoked from this phase.
  validationResult Json

  // DRAFT does not lock the return period; multiple drafts may architecturally exist, though
  // normally only the latest active draft is used. Exactly one snapshot eventually becomes FILED.
  // No lifecycle transition logic is implemented in this phase.
  status String @default("DRAFT")

  // For the current live-query architecture this will eventually correspond to snapshot creation
  // time — not computed here.
  sourceDataCutoff DateTime
  // The report parameters used to construct this snapshot (gstRegistrationId, from, to, branch
  // scope, ...) — preserved verbatim, shape intentionally left to whatever the export DTO/request
  // carries when G2g-6b actually builds a snapshot.
  reportParams     Json

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  filingAttempts GstFilingAttempt[]
  // Reverse of GstReturnPeriod.filedSnapshot above.
  filedByPeriod  GstReturnPeriod[]  @relation("GstReturnPeriodFiledSnapshot")

  @@unique([returnPeriodId, version])
  // composite-FK target: lets the database refuse a filing attempt pointing at another company's snapshot.
  @@unique([id, companyId])
  @@index([companyId])
  @@index([returnPeriodId])
  @@map("gst_filing_snapshots")
}

// A record that a filing was attempted for a GstReturnPeriod against one exact GstFilingSnapshot.
// No filing/GSP/ASP/API integration exists in this phase — mode/status are persistence-only;
// nothing in this codebase writes these rows yet, and no retry/attempt-number allocation logic is
// implemented here.
model GstFilingAttempt {
  id             String            @id @default(cuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id])
  returnPeriodId String
  returnPeriod   GstReturnPeriod   @relation(fields: [returnPeriodId, companyId], references: [id, companyId])
  // Never allow a filing attempt to exist without identifying its exact payload snapshot.
  snapshotId     String
  snapshot       GstFilingSnapshot @relation(fields: [snapshotId, companyId], references: [id, companyId])

  attemptNumber Int

  // MANUAL_EXPORT | MANUAL_UPLOAD | GSP | ASP | API. TRIVO does not file GSTR-1 through GSTN today
  // — GSP/ASP/API are future architecture only, not implemented/integrated in this phase.
  mode   String
  // ATTEMPTED | ACCEPTED | REJECTED | SUPERSEDED. No state-transition logic is implemented in this
  // phase; nothing automatically changes GstReturnPeriod.status off this column.
  status String @default("ATTEMPTED")

  attemptedAt DateTime  @default(now())
  filedAt     DateTime?

  // Real, externally-issued GST ARN once filed. Never generated or validated against an external
  // service by this system.
  arn               String?
  externalReference String?

  // Eventually equal to the snapshot's wireJsonHash — evidence of exactly which payload was
  // submitted. Not calculated/enforced in this phase.
  payloadHash String

  // Future GSP/ASP/API response metadata — no integration exists in this phase.
  responseMetadata Json?

  errorCode    String?
  errorMessage String?

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  // G2g-6e: reverse of GstReturnPeriod.filedByAttempt above — normally at most one period ever
  // points back at a given attempt (an attempt belongs to exactly one period), but Prisma still
  // requires the list form on this side of the named relation.
  filedForPeriod GstReturnPeriod[] @relation("GstReturnPeriodFiledAttempt")

  @@unique([returnPeriodId, attemptNumber])
  @@unique([id, companyId])
  @@index([companyId])
  @@index([returnPeriodId])
  @@index([snapshotId])
  @@map("gst_filing_attempts")
}

// G1: a company's tax-invoice print layout. Structurally mirrors EstimateTemplate/TagTemplate
// (one Json `layout` column, no separate element table) — same precedent, not a new pattern.
// UNLIKE those two, `layout` here controls PRESENTATION ONLY (section visibility/order, column
// choice, labels, footer text): every bound value it can reference is resolved server-side from
// a fixed whitelist (shared/taxInvoiceBoundFields.ts) against SalesInvoice/TaxInvoice/the
// registration/client snapshot — never against arbitrary columns, and never overridable (a
// template cannot change what GSTIN or tax amount gets printed, only whether/how it's labelled
// and where it sits). branchId is optional: null = this template is available company-wide /
// as the company default; set = this template is this one branch's override (resolveTemplate()
// in taxInvoiceTemplate.service.ts prefers a branch-specific match, else the company default,
// else a safe built-in fallback — same explicit-override-else-default shape as TagTemplate's
// print-time resolution).
model TaxInvoiceTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  branchId    String?
  branch      Branch?  @relation(fields: [branchId, companyId], references: [id, companyId])
  layout      Json
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@map("tax_invoice_templates")
}

// G2a: a company's credit-note print layout. Structurally identical to TaxInvoiceTemplate —
// same Json `layout` column, same branch-override-else-company-default-else-built-in resolution
// shape, same presentation-only scope (no service/resolver/UI built in this step; that is G2b+).
model CreditNoteTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  branchId    String?
  branch      Branch?  @relation(fields: [branchId, companyId], references: [id, companyId])
  layout      Json
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@map("credit_note_templates")
}

// G2a: a company's debit-note print layout. Mirrors CreditNoteTemplate/TaxInvoiceTemplate exactly.
model DebitNoteTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  branchId    String?
  branch      Branch?  @relation(fields: [branchId, companyId], references: [id, companyId])
  layout      Json
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@map("debit_note_templates")
}

// Membership: ties a global User identity to one Company, with a company-owned Role and a
// branch-access configuration (UserBranchAccess). One User may hold several CompanyUser rows
// (one per company they work with) — see the multi-tenant blueprint's Option B reasoning.
// username is optional and company-scoped (unique per company) — the "Username" half of the
// login concept for companies that want short, non-email handles; email (on User) stays the
// durable, globally-unique identity underneath (see blueprint §3's explicit email decision).
model CompanyUser {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  roleId      String
  role        Role      @relation(fields: [roleId, companyId], references: [id, companyId])
  username    String?
  // Company-specific employee data (moved off the global User in Phase 2 of company isolation).
  // employeeId is unique PER COMPANY: Company A and Company B may each have an "E001".
  employeeId  String?
  department  String?
  phone       String?
  lastLoginAt DateTime?
  // Explicit "sees every branch" flag — deliberately NOT "zero UserBranchAccess rows = unrestricted"
  // (an ambiguous, fail-OPEN default). Default false: a membership with no branch grants and
  // allBranches=false sees zero branches — fail-closed.
  allBranches Boolean   @default(false)
  isActive    Boolean   @default(true)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branchAccess       UserBranchAccess[]
  acceptedInvitation CompanyInvitation?

  @@unique([companyId, userId])
  @@unique([companyId, username])
  @@unique([companyId, employeeId])
  // Target of UserBranchAccess's composite FK — lets the DATABASE reject a grant whose companyId
  // differs from the membership's own company.
  @@unique([id, companyId])
  @@index([userId])
  @@map("company_users")
}

// One explicit branch grant for a restricted (allBranches=false) CompanyUser.
// A grant of one branch to one company membership. companyId is stored directly (RLS + a plain
// tenant filter) AND tied to both parents by COMPOSITE foreign keys — (companyUserId, companyId)
// -> company_users(id, companyId) and (branchId, companyId) -> branches(id, companyId) — so the
// database itself makes it impossible for a grant to link a membership of one company to a branch
// of another, independent of any application check.
model UserBranchAccess {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  companyUserId String
  companyUser   CompanyUser @relation(fields: [companyUserId, companyId], references: [id, companyId], onDelete: Cascade)
  branchId      String
  branch        Branch      @relation(fields: [branchId, companyId], references: [id, companyId])
  createdAt     DateTime    @default(now())

  @@unique([companyUserId, branchId])
  @@index([branchId])
  @@index([companyId])
  @@map("user_branch_access")
}

// Atomic, company-scoped, concurrency-safe document numbering — replaces the old global
// "find latest matching prefix + 1" scan (shared/numbering.ts). Keyed by
// (companyId, documentType, financialYear); financialYear is null for counters that aren't
// year-scoped (e.g. tagNumber, whose "year" is really a (stockType, category) prefix baked
// into documentType instead — see shared/numberSequence.ts).
model NumberSequence {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  documentType  String
  financialYear Int?
  lastValue     Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([companyId, documentType, financialYear])
  @@map("number_sequences")
}

// User is a GLOBAL identity — deliberately NOT company-scoped (no companyId here). Company
// membership, role, and branch access all live on CompanyUser instead. See the multi-tenant
// blueprint §3 for the full reasoning (one person, one identity, N company memberships).
// GLOBAL LOGIN IDENTITY ONLY: email, password hash, display name, active flag. Every fact about the
// person INSIDE one company (employee id, department, phone, username, role, branch access, last
// login there) lives on that company's CompanyUser membership row — so one person can belong to
// several companies without either company seeing the other's data about them.
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  isActive  Boolean   @default(true)
  // Platform-level only — never exposed to a company (it would reveal activity in OTHER companies).
  // A company sees CompanyUser.lastLoginAt instead, which is that company's own.
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  companyMemberships           CompanyUser[]
  auditLogs                    AuditLog[]
  karigarIssues                KarigarLedger[]        @relation("IssuedBy")
  qcSignoffs                   QcCheckpoint[]
  wipEntries                   WipTracking[]
  requestedRequisitions        PurchaseRequisition[]  @relation("PRRequester")
  approvedRequisitions         PurchaseRequisition[]  @relation("PRApprover")
  performedApprovals           ApprovalHistory[]
  submittedPOs                 PurchaseOrder[]        @relation("POSubmitter")
  approvedPOs                  PurchaseOrder[]        @relation("POApprover")
  tagsCreated                  JewelryTag[]           @relation("TagCreatedBy")
  transfersRequested           BranchTransfer[]       @relation("TransferRequester")
  transfersApproved            BranchTransfer[]       @relation("TransferApprover")
  invoicesSold                 SalesInvoice[]
  stockAuditsStarted           StockAudit[]
  tagTemplatesCreated          TagTemplate[]
  tagEstimatesCreated          TagEstimate[]          @relation("EstimateCreatedBy")
  tagEstimatesAttended         TagEstimate[]          @relation("EstimateSalesPerson")
  invoiceItemsSold             InvoiceItem[]          @relation("InvoiceItemSalesPerson")
  estimateTemplatesCreated     EstimateTemplate[]
  taxInvoiceTemplatesCreated   TaxInvoiceTemplate[]
  invitationsSent              CompanyInvitation[]    @relation("InvitationInviter")
  platformAuditLogs            PlatformAuditLog[]
  invoicesVoided               SalesInvoice[]         @relation("InvoiceVoidedBy")
  paymentsReversed             InvoicePayment[]       @relation("PaymentReversedBy")
  exchangesReversed            OldGoldExchange[]      @relation("ExchangeReversedBy")
  // G2a
  creditNotesCreated           CreditNote[]           @relation("CreditNoteCreatedBy")
  creditNotesCancelled         CreditNote[]           @relation("CreditNoteCancelledBy")
  debitNotesCreated            DebitNote[]            @relation("DebitNoteCreatedBy")
  debitNotesCancelled          DebitNote[]            @relation("DebitNoteCancelledBy")
  creditNoteTemplatesCreated   CreditNoteTemplate[]
  debitNoteTemplatesCreated    DebitNoteTemplate[]
  // G2g-4b — Sales Debit Note (outward, sell-side). Distinct relation names from the
  // procurement DebitNote above — the two domains never share a permission or a relation.
  salesDebitNotesCreated       SalesDebitNote[]       @relation("SalesDebitNoteCreatedBy")
  salesDebitNotesCancelled     SalesDebitNote[]       @relation("SalesDebitNoteCancelledBy")
  // G2g-7d — inward RCM foundation.
  rcmLiabilitiesCreated        RcmLiability[]         @relation("RcmLiabilityCreatedBy")
  rcmLiabilitiesPaid           RcmLiability[]         @relation("RcmLiabilityPaidBy")
  selfInvoicesCreated          SelfInvoice[]          @relation("SelfInvoiceCreatedBy")
  selfInvoicesCancelled        SelfInvoice[]          @relation("SelfInvoiceCancelledBy")
  // G2g-6a: schema-only foundation — no code creates these rows yet.
  gstFilingSnapshotsCreated    GstFilingSnapshot[]
  gstFilingAttemptsCreated     GstFilingAttempt[]
  // G2g-6e: the actor who performed each controlled lifecycle transition.
  gstReturnPeriodsFiled        GstReturnPeriod[]      @relation("GstReturnPeriodFiledBy")
  gstReturnPeriodsLocked       GstReturnPeriod[]      @relation("GstReturnPeriodLockedBy")
  // G2g-7e: GSTR-2B ingestion.
  gst2bStatementsImported      Gst2bStatement[]       @relation("Gst2bStatementImportedBy")
  // G8a: GST integration foundation (config admin only — no provider/network action is ever
  // attributed to a user in this phase, since none is performed).
  gstIntegrationConfigsCreated GstIntegrationConfig[] @relation("GstIntegrationConfigCreatedBy")
  gstIntegrationConfigsUpdated GstIntegrationConfig[] @relation("GstIntegrationConfigUpdatedBy")
  eInvoiceRecordsCreated       EInvoiceRecord[]       @relation("EInvoiceRecordCreatedBy")

  @@map("users")
}

// companyId is nullable, not required: audit entries are written from every service in the
// codebase, including modules that aren't tenant-scoped yet (manufacturing/outsourcing/design —
// dormant per CLAUDE.md — and procurement's PO/GRN/PR, still pending the 81-model rollout). A
// row whose underlying table has no companyId of its own has no honest value to stamp here
// either. NULL is also the fail-safe choice for the RLS policy below: `"companyId" = <session>`
// never matches NULL, so an unscoped historical entry simply never appears in ANY company's
// scoped view — it doesn't leak, it just isn't attributable yet.
model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  tableName String
  recordId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([companyId])
  @@index([tableName, recordId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}

// Audit events that belong to the TRIVO PLATFORM, not to any company (e.g. a company being
// provisioned or suspended by an operator, or legacy audit rows that could not be attributed to a
// company without guessing). Deliberately a SEPARATE table with no companyId: a company audit
// event must never be written here, and this table is never exposed through any company route or
// granted to the tenant runtime DB role (see prisma/production-rls-roles.sql). Written only via
// createPlatformAuditEntry() in middleware/audit.ts.
model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  subjectType String?
  subjectId   String?
  metadata    Json?
  timestamp   DateTime @default(now())

  @@index([timestamp])
  @@index([action])
  @@map("platform_audit_logs")
}

// An explicit, pending offer for a person to join ONE company. This replaces the old behaviour
// where createCompanyUser silently attached whichever global User already owned an email: a
// membership is only ever created when the RECIPIENT accepts (proving control of the invitation via
// its one-time token, and — if they already have a login — that login's password).
//
// The raw token is shown to the inviting admin exactly once (there is no email provider wired yet;
// an email sender can deliver the same token later) and only its SHA-256 hash is stored. The
// employee fields are staged here and only become a CompanyUser at acceptance.
model CompanyInvitation {
  id                    String       @id @default(cuid())
  companyId             String
  company               Company      @relation(fields: [companyId], references: [id])
  email                 String // normalised lower-case: the address this invitation was issued to
  roleId                String
  role                  Role         @relation(fields: [roleId, companyId], references: [id, companyId])
  allBranches           Boolean      @default(false)
  branchIds             String[] // this company's branches; re-validated at acceptance
  username              String?
  employeeId            String?
  department            String?
  phone                 String?
  tokenHash             String       @unique
  status                String       @default("PENDING") // PENDING | ACCEPTED | REVOKED (expiry is computed from expiresAt)
  expiresAt             DateTime
  // NULL for an invitation issued by a TRIVO platform operator (e.g. the first admin of a company,
  // when that email already has a login elsewhere) — recorded in platform_audit_logs instead.
  invitedById           String?
  invitedBy             User?        @relation("InvitationInviter", fields: [invitedById], references: [id])
  acceptedAt            DateTime?
  acceptedCompanyUserId String?      @unique
  acceptedCompanyUser   CompanyUser? @relation(fields: [acceptedCompanyUserId], references: [id])
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([companyId, email])
  @@index([companyId, status])
  @@map("company_invitations")
}

// companyId direct — Phase 3. A physical scale/barcode/RFID device is registered to one
// company's own branch counter — this is live (RS232 scale integration), not dormant.
model HardwareDevice {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  deviceType String
  deviceId   String
  port       String?
  baudRate   Int?
  ipAddress  String?
  location   String?
  // The branch this device physically sits in (optional: NULL = company-wide). A branch-restricted user
  // only sees / reads devices in their own branches. Tied to the branch by a composite FK so a device can
  // never point at another company's branch.
  branchId   String?
  branch     Branch?   @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  isActive   Boolean   @default(true)
  lastPing   DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@unique([companyId, deviceId])
  @@index([companyId])
  @@index([branchId])
  @@map("hardware_devices")
}

// Company-scoped key/value settings — each company owns its own copy of every key (unique on
// [companyId, key], not on key alone), so one company changing e.g. DEFAULT_GOLD_MARGIN never
// changes it for another. Previously a global table (a single `key @unique` row shared by every
// company); see migration 20260924010000_system_config_tenant_scope.
model SystemConfig {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  key       String
  value     String
  category  String
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
  @@map("system_configs")
}

// ═══════════════════════════════════════════════════
// MODULE 1: PRODUCT DESIGN & CAD/BOM VAULT
// ═══════════════════════════════════════════════════

model DesignCategory {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  designs   Design[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("design_categories")
}

// companyId direct — Phase 3. Design/BOM/CostEstimate are dormant manufacturing modules (see
// CLAUDE.md) but are scoped now for architectural completeness, per the Phase 3 rollout — a
// piece's design lineage (JewelryTag.designId) must never resolve across a company boundary if
// this module is ever activated.
model Design {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  designCode     String
  name           String
  category       DesignCategory @relation(fields: [categoryId], references: [id])
  categoryId     String
  metalKarat     String
  grossWeightMin Decimal        @db.Decimal(10, 4)
  grossWeightMax Decimal        @db.Decimal(10, 4)
  netWeightMin   Decimal        @db.Decimal(10, 4)
  netWeightMax   Decimal        @db.Decimal(10, 4)
  description    String?
  status         String         @default("DRAFT")
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  designFiles   DesignFile[]
  bomItems      BomItem[]
  bomProcesses  BomProcess[]
  costEstimates CostEstimate[]
  orderItems    OrderItem[]
  jobCards      JobCard[]
  jewelryTags   JewelryTag[]

  @@unique([companyId, designCode])
  @@index([companyId])
  @@index([status])
  @@map("designs")
}

model DesignFile {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  design     Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId   String
  fileType   String
  fileName   String
  filePath   String
  fileSize   BigInt?
  mimeType   String?
  version    Int      @default(1)
  isActive   Boolean  @default(true)
  uploadedAt DateTime @default(now())

  @@index([companyId])
  @@map("design_files")
}

model BomItem {
  id             String  @id @default(cuid())
  companyId      String
  company        Company @relation(fields: [companyId], references: [id])
  design         Design  @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId       String
  materialType   String
  materialCode   String
  materialName   String
  quantity       Decimal @db.Decimal(10, 4)
  unit           String
  karat          String?
  quality        String?
  sieveSize      String?
  wastagePercent Decimal @default(0) @db.Decimal(5, 2)
  sequence       Int     @default(0)

  @@index([companyId])
  @@map("bom_items")
}

model BomProcess {
  id                String  @id @default(cuid())
  companyId         String
  company           Company @relation(fields: [companyId], references: [id])
  design            Design  @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId          String
  processName       String
  sequence          Int
  makingChargeType  String
  makingChargeValue Decimal @db.Decimal(10, 2)
  wastagePercent    Decimal @default(0) @db.Decimal(5, 2)
  estimatedMinutes  Int?
  isOutsourced      Boolean @default(false)

  @@index([companyId])
  @@map("bom_processes")
}

// companyId direct — Phase 3. A daily metal rate is each jeweler's OWN quoted/entered rate (used
// directly in pricing — resolveMetalRate feeds createInvoice/createTagFromGrnItem/
// createOldGoldExchange), not a shared public market feed with one true value — two companies
// legitimately enter different rates. Every existing caller already carries a ctx.
model MetalRate {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  date          DateTime @db.Date
  karat         String
  purity        Decimal  @db.Decimal(6, 4)
  ratePerGram   Decimal  @db.Decimal(12, 4)
  // OG = Old Gold: what the shop pays per gram for a customer's old metal of this karat that day.
  // Optional — a day with no OG rate entered just has none.
  ogRatePerGram Decimal? @db.Decimal(12, 4)
  currency      String   @default("INR")
  source        String?
  createdAt     DateTime @default(now())

  @@unique([companyId, date, karat, currency])
  @@index([companyId, date])
  @@map("metal_rates")
}

// Fixed karat/purity list (C1). karat/metalKarat columns elsewhere (JewelryTag, PoItem,
// MetalRate, MemoItem, InvoiceItem) stay free-text — this is the validation source of
// truth for those writes, not a schema-wide FK migration.
model KaratMaster {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String // "24K", "22K", "18K", "14K", "SILVER", "PT"
  metalType String // GOLD | SILVER | PLATINUM
  purity    Decimal  @db.Decimal(6, 4)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, code])
  @@index([companyId])
  @@map("karat_master")
}

model CostEstimate {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  design         Design   @relation(fields: [designId], references: [id])
  designId       String
  estimateNumber String
  metalSpotRate  Decimal  @db.Decimal(12, 4)
  metalCost      Decimal  @db.Decimal(12, 2)
  stoneCost      Decimal  @db.Decimal(12, 2)
  makingCharges  Decimal  @db.Decimal(12, 2)
  wastageAmount  Decimal  @db.Decimal(12, 2)
  totalCost      Decimal  @db.Decimal(12, 2)
  marginPercent  Decimal  @db.Decimal(5, 2)
  sellingPrice   Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR")
  validUntil     DateTime
  status         String   @default("DRAFT")
  notes          String?
  createdAt      DateTime @default(now())

  @@unique([companyId, estimateNumber])
  @@index([companyId])
  @@map("cost_estimates")
}

// ═══════════════════════════════════════════════════
// MODULE 2: PURCHASE & PROCUREMENT CONTROL
// ═══════════════════════════════════════════════════

// companyId direct — Phase 3. Reversed from the earlier "keep Supplier global" call: Supplier
// carries real company-private data (GSTIN, PAN, bank account/IFSC, credit terms) — the same
// class of private business-relationship data as Client, which is already company-scoped. It is
// NOT reference/taxonomy data like ProductCategory or KaratMaster, so it doesn't belong in that
// bucket.
model Supplier {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  supplierCode  String
  name          String
  type          String
  gstNumber     String?
  panNumber     String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  contactName   String?
  phone         String?
  email         String?
  bankName      String?
  bankAccount   String?
  bankIfsc      String?
  creditLimit   Decimal? @db.Decimal(12, 2)
  currentDue    Decimal  @default(0) @db.Decimal(12, 2)
  // G2g-7a: whether this supplier is registered under the GST Composition Scheme — a fact about
  // the supplier's OWN registration (not about any one transaction), relevant to future ITC-
  // eligibility checks (a composition dealer's bill carries no GST a buyer can claim as input
  // credit). Deliberately NOT paired with an "isRcmLiable" flag here — reverse-charge
  // applicability turns on the nature of the specific supply/HSN, not a permanent property of the
  // supplier identity; see PHASE_G2G7A_IMPLEMENTATION.md §E. Defaults false (a regular registered
  // dealer, the overwhelming common case) for every existing row — never inferred from gstNumber
  // being present/absent, which is a registration question, not a scheme question.
  isComposition Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  artisans       Artisan[]
  returns        PurchaseReturn[]
  payments       SupplierPayment[]
  componentRates VendorComponentRate[]
  debitNotes     DebitNote[]
  // G2g-7d: inward RCM foundation.
  rcmLiabilities RcmLiability[]
  selfInvoices   SelfInvoice[]

  @@unique([companyId, supplierCode])
  // composite-FK target: lets the database refuse a child that points at another company's Supplier
  @@unique([id, companyId])
  @@index([companyId])
  @@map("suppliers")
}

// Goods sent back to a supplier (D3) — mirrors SalesReturn on the buy side. Scoped to tagged
// finished-goods pieces only (JewelryTag.grnItemId set): the live post-pivot business path.
// Deliberately doesn't touch Supplier.currentDue, PoItem.receivedQty/receivedWt, or the original
// GRN row — procurement never wired currentDue as a live balance in the first place (nothing to
// reverse), and PO/GRN receipts stay historical, same "never rewrite history" rule as SalesReturn.
// companyId direct — Phase 2b (procurement tenant scoping). Resolved from ctx, cross-checked
// against every returned tag's own companyId (see createPurchaseReturn) the same way every
// other Phase 2 write validates ownership before touching anything.
// Money paid OUT to a supplier — the mirror of InvoicePayment. Posts Dr Accounts Payable / Cr Cash-or-Bank
// and reduces Supplier.currentDue (the live payable: intake adds to it, a return and a payment reduce it).
// Not tied to a specific bill: it is a payment on the supplier's account (referenceNo/notes say what for).
model SupplierPayment {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  paymentNumber String
  supplier      Supplier @relation(fields: [supplierId, companyId], references: [id, companyId])
  supplierId    String
  paymentDate   DateTime
  amount        Decimal  @db.Decimal(12, 2)
  mode          String
  referenceNo   String?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([companyId, paymentNumber])
  @@index([companyId])
  @@index([supplierId])
  @@map("supplier_payments")
}

model PurchaseReturn {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  returnNumber String
  supplier     Supplier @relation(fields: [supplierId, companyId], references: [id, companyId])
  supplierId   String
  returnDate   DateTime @default(now())
  reason       String?
  notes        String?
  // totalAmount = value of the goods returned (excl. GST); taxAmount = the input GST reversed on
  // them. What the supplier owes back (their credit/debit note) is the two together.
  totalAmount  Decimal  @db.Decimal(12, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  items     PurchaseReturnItem[]
  debitNote DebitNote?

  @@unique([companyId, returnNumber])
  // composite-FK target: lets the database refuse a child that points at another company's PurchaseReturn
  @@unique([id, companyId])
  @@index([companyId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id])
  return    PurchaseReturn @relation(fields: [returnId, companyId], references: [id, companyId], onDelete: Cascade)
  returnId  String
  tag       JewelryTag     @relation(fields: [tagId, companyId], references: [id, companyId])
  tagId     String
  amount    Decimal        @db.Decimal(12, 2)
  // Input GST reversed on this line — split the same way the original intake booked it.
  cgst      Decimal        @default(0) @db.Decimal(12, 2)
  sgst      Decimal        @default(0) @db.Decimal(12, 2)
  igst      Decimal        @default(0) @db.Decimal(12, 2)

  @@index([companyId])
  @@map("purchase_return_items")
}

// G2a: the purchase-side mirror of CreditNote (schema/RLS foundation only — see CreditNote's own
// comment and CLAUDE.md's G2a entry; no service/GST-calculation/journal logic yet). References a
// GoodsReceiptNote, not a PurchaseOrder/invoice model of its own — this codebase has no separate
// "purchase invoice" model; the GRN IS the receipt of the supplier's bill (see PoItem.hsnCodeId/
// taxRate for how purchase-side GST is already tracked line-by-line). supplierInvoiceNumber/Date
// are copied from the GRN's own invoiceNumber/invoiceDate at note-creation time (a snapshot, same
// immutability rule as CreditNote's originalInvoiceNumber/Date). purchaseReturnId is optional and
// @@unique([purchaseReturnId, companyId]) for the same reason as CreditNote.salesReturnId — at most
// one debit note per purchase return (PurchaseReturn.debitNote is a to-one back-relation).
// Deliberately carries NO irn/ackNumber/ackDate/qrCodeData — a debit note is issued BY this
// company TO a supplier, so it is never itself an e-invoice document on our side, unlike CreditNote/
// TaxInvoice on the sell side.
model DebitNote {
  id                    String           @id @default(cuid())
  companyId             String
  company               Company          @relation(fields: [companyId], references: [id])
  debitNoteNumber       String
  financialYear         Int
  debitNoteDate         DateTime         @default(now())
  grn                   GoodsReceiptNote @relation(fields: [grnId, companyId], references: [id, companyId])
  grnId                 String
  supplierInvoiceNumber String?
  supplierInvoiceDate   DateTime?
  purchaseReturn        PurchaseReturn?  @relation(fields: [purchaseReturnId, companyId], references: [id, companyId])
  purchaseReturnId      String?
  supplier              Supplier         @relation(fields: [supplierId, companyId], references: [id, companyId])
  supplierId            String
  reasonCode            String
  reasonNotes           String?

  taxableAmount Decimal @db.Decimal(12, 2)
  cgst          Decimal @default(0) @db.Decimal(12, 2)
  sgst          Decimal @default(0) @db.Decimal(12, 2)
  igst          Decimal @default(0) @db.Decimal(12, 2)
  totalTax      Decimal @db.Decimal(12, 2)
  totalAmount   Decimal @db.Decimal(12, 2)

  status        String    @default("ISSUED")
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("DebitNoteCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?

  // Accounting pointer — plain FK, same reasoning as CreditNote.journalEntryId.
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdById String?
  createdBy   User?    @relation("DebitNoteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  items DebitNoteItem[]

  @@unique([companyId, debitNoteNumber])
  // composite-FK target: lets the database refuse a child that points at another company's DebitNote
  @@unique([id, companyId])
  // enforces at most one debit note per purchase return (PurchaseReturn.debitNote is a to-one back-relation)
  @@unique([purchaseReturnId, companyId])
  @@index([companyId])
  @@index([grnId])
  @@map("debit_notes")
}

model DebitNoteItem {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  debitNote   DebitNote @relation(fields: [debitNoteId, companyId], references: [id, companyId], onDelete: Cascade)
  debitNoteId String
  description String

  // Snapshot like PoItem.hsnCodeId/taxRate — a later HSN-rate change must not reprice a past note.
  hsnCode   HsnCode? @relation(fields: [hsnCodeId], references: [id])
  hsnCodeId String?
  taxRate   Decimal  @db.Decimal(5, 4)
  uom       String?

  taxableValue Decimal @default(0) @db.Decimal(12, 2)
  cgstAmount   Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount   Decimal @default(0) @db.Decimal(12, 2)
  igstAmount   Decimal @default(0) @db.Decimal(12, 2)
  lineTotalTax Decimal @default(0) @db.Decimal(12, 2)
  totalValue   Decimal @default(0) @db.Decimal(12, 2)

  grossWeight Decimal? @db.Decimal(10, 4)
  netWeight   Decimal? @db.Decimal(10, 4)
  stoneWeight Decimal? @db.Decimal(10, 4)
  karat       String?

  @@index([companyId])
  @@index([debitNoteId])
  @@map("debit_note_items")
}

// G2g-7d — Inward RCM (reverse-charge) foundation. See PHASE_G2G7D_AUDIT.md / PHASE_G2G7D_IMPLEMENTATION.md
// for the full read-only audit, legal research, and design rationale. Summary of what this is and is not:
//
// A self-assessed RCM liability on ONE inward supply line — created only when PoItem.rcmCategory
// (shared/rcmCategory.ts) classifies as RCM_APPLICABLE (gstr3bRcmClassification.ts), at the exact moment
// the line's ordinary input-GST fields are booked on GrnItem (createTagFromGrnItem / openPurchaseLot) —
// never at PO time, and never re-derived later. Deliberately line-level, never a Supplier-level flag
// (CGST Act §9(4)'s blanket unregistered-supplier RCM has been suspended since Feb 2019 — RCM turns on the
// specific notified supply, not on the supplier's registration status).
//
// THIS IS A DORMANT FOUNDATION AGAINST TODAY'S REAL DATA, not a live, populated ledger: PoItem.rcmCategory
// defaults to NULL/NONE for every line, TRIVO's two actual inward-supply flows (jewellery-stock PO/GRN,
// old-gold exchange) are not RCM-liable under current law (§9(4) suspended; the only metal-scrap RCM
// notification excludes Chapter 71 precious metals), and the realistic §9(3) categories for this business
// (GTA freight, legal fees, security, director fees) are services with no line-item representation
// anywhere in this schema. This table will stay empty until something explicitly sets a non-NONE
// rcmCategory — see PHASE_G2G7D_AUDIT.md §B.1/§A.1 for the full reasoning, and the "foundation only"
// scope decision it was built against.
model RcmLiability {
  id                String                  @id @default(cuid())
  companyId         String
  company           Company                 @relation(fields: [companyId], references: [id])
  gstRegistration   CompanyGstRegistration? @relation(fields: [gstRegistrationId, companyId], references: [id, companyId])
  gstRegistrationId String?
  grnItem           GrnItem                 @relation(fields: [grnItemId, companyId], references: [id, companyId])
  grnItemId         String
  supplier          Supplier                @relation(fields: [supplierId, companyId], references: [id, companyId])
  supplierId        String

  // Snapshot of the category that produced this liability — never re-read from PoItem after
  // creation, same immutability rule as taxRate/hsnCodeId elsewhere in this schema.
  rcmCategory String

  taxableValue Decimal @db.Decimal(12, 2)
  cgst         Decimal @default(0) @db.Decimal(12, 2)
  sgst         Decimal @default(0) @db.Decimal(12, 2)
  igst         Decimal @default(0) @db.Decimal(12, 2)
  cess         Decimal @default(0) @db.Decimal(12, 2)

  // SELF_INVOICE_REQUIRED | SELF_INVOICE_NOT_REQUIRED | SELF_INVOICE_NOT_DETERMINED — required only
  // when the supplier is unregistered (Section 31(3)(f)/Rule 47A); a registered supplier's own
  // invoice suffices and no self-invoice is created.
  selfInvoiceRequirement String
  selfInvoice            SelfInvoice?

  // PAYMENT_VOUCHER_REQUIRED | PAYMENT_VOUCHER_NOT_REQUIRED | PAYMENT_VOUCHER_NOT_DETERMINED
  // (Section 31(3)(g)) — architecture/status only in this phase; no document is generated.
  paymentVoucherRequirement String

  // LIABILITY_RECOGNIZED (self-assessed, not yet paid in cash) | TAX_PAID (paid — the only state
  // that can ever make a future ITC claim ELIGIBLE, per Rule 86(2): RCM tax must be paid from the
  // electronic cash ledger before it can be claimed back as credit).
  status                String        @default("LIABILITY_RECOGNIZED")
  paidAt                DateTime?
  paidById              String?
  paidBy                User?         @relation("RcmLiabilityPaidBy", fields: [paidById], references: [id])
  paymentMode           String?
  paymentJournalEntryId String?
  paymentJournalEntry   JournalEntry? @relation("RcmLiabilityPaymentJournal", fields: [paymentJournalEntryId], references: [id])

  // The liability-recognition journal (Dr RCM Input Tax Credit / Cr RCM Tax Payable), posted at
  // creation — plain FK, same reasoning as DebitNote.journalEntryId.
  journalEntryId String?
  journalEntry   JournalEntry? @relation("RcmLiabilityJournal", fields: [journalEntryId], references: [id])

  createdById String?
  createdBy   User?    @relation("RcmLiabilityCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  // one liability per GRN line; composite-FK target for SelfInvoice
  @@unique([grnItemId, companyId])
  @@unique([id, companyId])
  @@index([companyId])
  @@index([gstRegistrationId])
  @@index([supplierId])
  @@map("rcm_liabilities")
}

// A self-invoice under Section 31(3)(f)/Rule 47A — created only when an RcmLiability's
// selfInvoiceRequirement is SELF_INVOICE_REQUIRED. Numbered per the company's own GST registration
// (nextDocumentNumber's registration-scoped key, the same proven pattern as CreditNote/
// SalesDebitNote's `CN:`/`SDN:` keys). Every money/HSN field is a snapshot copied from its
// RcmLiability at issue time, mirroring DebitNote's supplierInvoiceNumber/Date snapshot convention.
model SelfInvoice {
  id                String                  @id @default(cuid())
  companyId         String
  company           Company                 @relation(fields: [companyId], references: [id])
  selfInvoiceNumber String
  financialYear     Int
  gstRegistration   CompanyGstRegistration? @relation(fields: [gstRegistrationId, companyId], references: [id, companyId])
  gstRegistrationId String?
  rcmLiability      RcmLiability            @relation(fields: [rcmLiabilityId, companyId], references: [id, companyId])
  rcmLiabilityId    String
  supplier          Supplier                @relation(fields: [supplierId, companyId], references: [id, companyId])
  supplierId        String
  // Snapshot — a later edit to the Supplier row must not rewrite an already-issued self-invoice.
  supplierName      String
  supplierAddress   String?

  issueDate    DateTime @default(now())
  taxableValue Decimal  @db.Decimal(12, 2)
  cgst         Decimal  @default(0) @db.Decimal(12, 2)
  sgst         Decimal  @default(0) @db.Decimal(12, 2)
  igst         Decimal  @default(0) @db.Decimal(12, 2)
  cess         Decimal  @default(0) @db.Decimal(12, 2)
  hsnCode      HsnCode? @relation(fields: [hsnCodeId], references: [id])
  hsnCodeId    String?

  status        String    @default("ISSUED")
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("SelfInvoiceCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?

  createdById String?
  createdBy   User?    @relation("SelfInvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([companyId, selfInvoiceNumber])
  @@unique([id, companyId])
  // at most one self-invoice per liability (RcmLiability.selfInvoice is a to-one back-relation)
  @@unique([rcmLiabilityId, companyId])
  @@index([companyId])
  @@index([gstRegistrationId])
  @@map("self_invoices")
}

// G2g-7e — GSTR-2B ingestion: one IMMUTABLE row per (company, GST registration, financial year, tax
// period, version). See PHASE_G2G7E_AUDIT.md / PHASE_G2G7E_IMPLEMENTATION.md for the full design.
// GSTR-2B is a government-GENERATED statement handed TO this company — the opposite direction from
// GstReturnPeriod (a return WE file) — so it is deliberately a separate, narrower model: no FILED/
// LOCKED/ARN concept exists here, only ACTIVE/SUPERSEDED (same vocabulary GstFilingSnapshot already
// uses for its own DRAFT->SUPERSEDED transition). A later re-import of the SAME period with
// different content creates a NEW, higher `version` and marks the prior one SUPERSEDED — never
// deleted, never overwritten (brief §3/§25). An import whose sourceFileHash OR canonicalPayloadHash
// matches the current ACTIVE statement for that exact period is a no-op duplicate — see
// gstr2bImport.service.ts.
model Gst2bStatement {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  gstRegistrationId String
  gstRegistration   CompanyGstRegistration @relation(fields: [gstRegistrationId, companyId], references: [id, companyId])

  // Indian FY convention ("YYYY-YY") / MMYYYY — identical shape to GstReturnPeriod's own fields,
  // deliberately NOT the same table (see header comment above).
  financialYear String
  taxPeriod     String

  // Only "GSTN_JSON" is supported in this phase (brief's own "prefer the smallest reliable
  // implementation" — §2 Option A). Plain string, not an enum, matching this codebase's convention
  // for every other extensible type/status field.
  source String @default("GSTN_JSON")

  // GSTN's own statement-generation timestamp, read from the source payload when the normalizer can
  // confidently locate it — left null rather than guessed when it can't (§2's own field-spelling
  // confidence caveat).
  generatedAt  DateTime?
  importedAt   DateTime  @default(now())
  importedById String?
  importedBy   User?     @relation("Gst2bStatementImportedBy", fields: [importedById], references: [id])

  // SHA-256 of the exact uploaded bytes (captured via a dedicated raw-body-preserving parser on the
  // import route only — see gstr2bImport.service.ts) and of the canonicalized parsed structure
  // (catches a re-saved file with different whitespace/key order as identical content) respectively.
  // Same hashing convention as gstr1SnapshotHash.ts (G2g-6b) — duplicated here as a small, generic,
  // pure utility (shared/gst2bHash.ts) rather than imported, to keep this phase's module boundary
  // independent of the named-frozen GSTR-1 filing snapshot module (brief §28).
  sourceFileHash       String
  canonicalPayloadHash String

  // Which version of gstr2bNormalizer.ts produced Gst2bDocument rows for this statement — so a
  // future correction to field-mapping is a documented RE-NORMALIZATION of already-preserved source
  // data, never a re-import (see PHASE_G2G7E_AUDIT.md §2).
  normalizerVersion String

  // The exact, complete, parsed source JSON — never rewritten after creation. This is what makes a
  // normalizer bug fixable without re-importing: the source of truth is preserved regardless of how
  // well the normalizer understood it at import time.
  rawPayload Json

  // ACTIVE | SUPERSEDED. At most one ACTIVE statement per (companyId, gstRegistrationId,
  // financialYear, taxPeriod) — enforced in gstr2bImport.service.ts's transaction, not a DB
  // constraint (same "uniqueness invariant enforced in a transaction" precedent as
  // CompanyGstRegistration.isPrimary).
  status String @default("ACTIVE")

  // Allocated via shared/numberSequence.ts's proven atomic per-key counter (documentType key
  // `GST2B:<gstRegistrationId>:<financialYear>:<taxPeriod>`) — never a count()+1 race.
  version Int

  documents Gst2bDocument[]

  @@unique([companyId, gstRegistrationId, financialYear, taxPeriod, version])
  // composite-FK target: lets the database refuse a document pointing at another company's statement
  @@unique([id, companyId])
  @@index([companyId])
  @@index([gstRegistrationId])
  @@index([companyId, gstRegistrationId, financialYear, taxPeriod, status])
  @@map("gst2b_statements")
}

// G2g-7e — one normalized row per source GSTR-2B document (B2B/B2BA/CDNR/CDNRA/ISD/ISDA/IMPG/
// IMPGSEZ entry). Structured and indexable, unlike Gst2bStatement.rawPayload, because this codebase
// has no other structured table to fall back on for 2B-shaped data (unlike GSTR-1 export, which
// reuses the already-structured SalesInvoice/CreditNote tables). See gstr2bNormalizer.ts for how
// this is produced, and gstr2bReconciliation.ts for how it is matched against book documents.
model Gst2bDocument {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  statement   Gst2bStatement @relation(fields: [statementId, companyId], references: [id, companyId], onDelete: Cascade)
  statementId String

  // B2B | B2BA | CDNR | CDNRA | ISD | ISDA | IMPG | IMPGSEZ — the GSTR-2B table this document was
  // read from (PHASE_G2G7E_AUDIT.md §2/§3).
  section String

  // INVOICE | CREDIT_NOTE | DEBIT_NOTE | ISD_INVOICE | IMPORT_BOE — the statutory document type,
  // distinct from `section` (B2BA is still an INVOICE document type, just an amendment row).
  documentType String

  supplierGstin     String?
  supplierTradeName String?
  // The source document's own number (or Bill-of-Entry number for IMPG/IMPGSEZ) — a free string,
  // never assumed to be in any particular format. Normalized for Level-2 matching at MATCH time
  // (gstr2bReconciliation.ts), never mutated here.
  documentNumber    String?
  documentDate      DateTime?
  documentValue     Decimal?  @db.Decimal(14, 2)
  placeOfSupply     String?

  taxableValue Decimal @default(0) @db.Decimal(14, 2)
  igst         Decimal @default(0) @db.Decimal(14, 2)
  cgst         Decimal @default(0) @db.Decimal(14, 2)
  sgst         Decimal @default(0) @db.Decimal(14, 2)
  cess         Decimal @default(0) @db.Decimal(14, 2)

  reverseCharge Boolean @default(false)

  // AVAILABLE | NOT_AVAILABLE | null (the source did not state one, or the normalizer could not
  // confidently locate it) — copied verbatim from the source's own ITC-availability classification,
  // never re-derived here (that re-derivation, against TRIVO's OWN books, is exactly what
  // gstr2bReconciliation.ts computes separately).
  itcAvailability     String?
  ineligibilityReason String?

  // ORIGINAL | AMENDED | SUPERSEDED | CURRENT (brief §15) — provenance, never collapsed away.
  // Defaults to CURRENT: the overwhelming case (a B2B/CDNR row with no amendment history at all).
  provenanceStatus String          @default("CURRENT")
  // Self-reference: which document (if any) THIS one amends. Populated only when the source payload
  // carries an unambiguous original-document reference the normalizer can resolve — never guessed
  // (PHASE_G2G7E_AUDIT.md §3's B2BA scope note).
  amendsDocumentId String?
  amendsDocument   Gst2bDocument?  @relation("Gst2bDocumentAmendment", fields: [amendsDocumentId, companyId], references: [id, companyId])
  amendedBy        Gst2bDocument[] @relation("Gst2bDocumentAmendment")

  // SUPPORTED | ISD_NOT_SUPPORTED | IMPORTS_NOT_RECONCILABLE (brief §7/§8) — a document the
  // normalizer preserved faithfully but that this phase does not attempt to reconcile against books.
  supportStatus String @default("SUPPORTED")

  // The exact source sub-object for this one document — full per-document traceability back to the
  // original statement, independent of how the structured columns above were derived.
  rawRecord Json

  createdAt DateTime @default(now())

  // composite-FK target: lets the database refuse an amendment pointing at another company's document
  @@unique([id, companyId])
  @@index([companyId])
  @@index([statementId])
  @@index([companyId, supplierGstin])
  @@index([companyId, section])
  @@map("gst2b_documents")
}

// ═══════════════════════════════════════════════════
// G8a — GST Integration Foundation. Provider-neutral infrastructure for a FUTURE e-invoice/IRP,
// GSTIN-lookup, and E-Way Bill integration (G8b+). This phase builds ONLY the boundary: config
// storage, encrypted credentials, an auth/session cache, a controlled HTTP client, error
// normalization, idempotency, and request/response tracking — see
// server/src/modules/gst/integration/. No real provider is implemented (the only concrete
// GstIntegrationProvider shipped here is UnconfiguredProvider — deterministic
// NOT_CONFIGURED/UNSUPPORTED_PROVIDER_OPERATION for every capability). No IRN generation, no
// GSTIN lookup (see shared/gstProvider.ts for the UNRELATED, pre-existing Phase-C GSTIN-registry
// lookup — this is not that), no E-Way Bill, no GST filing changes. See
// PHASE_G8A_IMPLEMENTATION.md.
// ═══════════════════════════════════════════════════

// One configured integration "slot": a specific GST registration × provider × environment. A
// company with GSTIN A and GSTIN B, each needing separate sandbox/production credentials with
// (possibly) different providers, gets up to 4 rows. Never a Company-wide credential — a GST
// registration is the correct ownership unit (G8a brief §6).
model GstIntegrationConfig {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  gstRegistration   CompanyGstRegistration @relation(fields: [gstRegistrationId, companyId], references: [id, companyId])
  gstRegistrationId String

  // GST_PROVIDER: IRIS_IRP | NIC_IRP | CYGNET_IRP | CLEAR_IRP | OTHER — see
  // modules/gst/integration/types.ts. Free string, same "fixed by this phase's own constant list,
  // not a DB enum" convention as taxCategory/rcmCategory elsewhere in this schema.
  provider    String
  // SANDBOX | PRODUCTION — structurally separate; never inferred from a URL (brief §9/§10).
  environment String

  label    String?
  isActive Boolean @default(true)

  // Last POST .../test result — a read-only service-level health probe, never an IRN/EWB mutation.
  lastTestedAt   DateTime?
  lastTestStatus String? // AVAILABLE | UNAVAILABLE | NOT_CONFIGURED | AUTH_FAILED | UNKNOWN

  credentials GstIntegrationCredential[]
  requestLogs GstIntegrationRequestLog[]

  createdById String?
  createdBy   User?    @relation("GstIntegrationConfigCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("GstIntegrationConfigUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  // One config per (registration, provider, environment) — never two active sandbox configs for
  // the same provider on the same registration.
  @@unique([gstRegistrationId, provider, environment])
  // composite-FK target
  @@unique([id, companyId])
  @@index([companyId])
  @@index([gstRegistrationId])
  @@map("gst_integration_configs")
}

// A single encrypted credential field on a config (clientId, clientSecret, username, password,
// portalId, apiKey, ...). Deliberately a generic key/value row, not fixed columns — different
// providers need different credential combinations and this must never need a schema migration
// per provider (G8a brief §8). The value is ALWAYS encrypted at rest
// (modules/gst/integration/encryption.ts); no service or route may select/return the plaintext —
// only the provider-adapter call path decrypts it, at the moment of use, never logged.
model GstIntegrationCredential {
  id        String               @id @default(cuid())
  companyId String
  company   Company              @relation(fields: [companyId], references: [id])
  config    GstIntegrationConfig @relation(fields: [configId, companyId], references: [id, companyId], onDelete: Cascade)
  configId  String

  // e.g. 'clientId' | 'clientSecret' | 'username' | 'password' | 'portalId' | 'apiKey' —
  // provider-defined, never validated against a fixed enum (brief §8's "no migration per
  // provider" requirement).
  credentialKey  String
  // AES-256-GCM ciphertext: "<iv>:<authTag>:<ciphertext>", each base64. Never selected into an
  // API response body.
  encryptedValue String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([configId, credentialKey])
  @@index([companyId])
  @@index([configId])
  @@map("gst_integration_credentials")
}

// Metadata-only record of one outbound (or locally-resolved) integration operation attempt —
// authenticate / health / future IRN-ish calls. No payload body is stored by default (brief
// §14) — only enough to trace, de-duplicate, and diagnose. The (companyId, idempotencyKey)
// unique constraint on non-null keys IS the idempotency mechanism (brief §13): a repeated key for
// the same company resolves to the existing row (requestTracking.service.ts), never a second one
// — Postgres treats NULLs as distinct, so operations with no idempotency key (most health checks)
// never collide with each other.
model GstIntegrationRequestLog {
  id        String               @id @default(cuid())
  companyId String
  company   Company              @relation(fields: [companyId], references: [id])
  config    GstIntegrationConfig @relation(fields: [configId, companyId], references: [id, companyId], onDelete: Cascade)
  configId  String

  // Denormalized snapshot of the config at request time — a later config edit (e.g. a provider
  // switch) must never rewrite the meaning of a past log row.
  provider    String
  environment String

  // AUTHENTICATE | HEALTH_CHECK | GET_GSTIN_DETAILS | GENERATE_IRN | CANCEL_IRN | GET_IRN |
  // GET_IRN_BY_DOCUMENT | GENERATE_EWAYBILL | CANCEL_EWAYBILL | OTHER — free string, future-proof.
  // Only AUTHENTICATE/HEALTH_CHECK are ever actually produced in this phase.
  operation String

  correlationId  String
  idempotencyKey String?

  requestStartedAt    DateTime
  completedAt         DateTime?
  // PENDING | SUCCESS | FAILED
  status              String    @default("PENDING")
  httpStatus          Int?
  providerReferenceId String?

  // AUTHENTICATION | AUTHORIZATION | VALIDATION | RATE_LIMIT | TIMEOUT | NETWORK | PROVIDER |
  // DUPLICATE | UNSUPPORTED | UNKNOWN — see errors.ts. Never a raw stack trace or raw provider body.
  errorCategory String?
  errorCode     String?
  errorMessage  String?

  createdAt DateTime @default(now())

  @@unique([companyId, idempotencyKey])
  @@index([companyId])
  @@index([configId])
  @@index([correlationId])
  @@map("gst_integration_request_logs")
}

// companyId direct — Phase 2b. purchaseRequisitionId may point at a PR from the same company
// only (enforced in convertToPO, mirroring the tag/branch cross-checks used everywhere else).
model PurchaseOrder {
  id                    String               @id @default(cuid())
  companyId             String
  company               Company              @relation(fields: [companyId], references: [id])
  poNumber              String
  supplier              Supplier             @relation(fields: [supplierId, companyId], references: [id, companyId])
  supplierId            String
  poType                String
  status                String               @default("DRAFT")
  orderDate             DateTime
  expectedDate          DateTime?
  currency              String               @default("INR")
  exchangeRate          Decimal              @default(1) @db.Decimal(10, 4)
  subtotal              Decimal              @default(0) @db.Decimal(12, 2)
  taxAmount             Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal              @default(0) @db.Decimal(12, 2)
  notes                 String?
  purchaseRequisitionId String?
  purchaseRequisition   PurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id])
  submittedAt           DateTime?
  submittedById         String?
  submittedBy           User?                @relation("POSubmitter", fields: [submittedById], references: [id])
  approvedAt            DateTime?
  approvedById          String?
  approvedBy            User?                @relation("POApprover", fields: [approvedById], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  poItems         PoItem[]
  grns            GoodsReceiptNote[]
  approvalHistory ApprovalHistory[]

  @@unique([companyId, poNumber])
  // composite-FK target: lets the database refuse a child that points at another company's PurchaseOrder
  @@unique([id, companyId])
  @@index([companyId])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PoItem {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  po           PurchaseOrder @relation(fields: [poId, companyId], references: [id, companyId], onDelete: Cascade)
  poId         String
  materialCode String
  materialName String
  materialType String
  quantity     Decimal       @db.Decimal(10, 4)
  weight       Decimal       @db.Decimal(10, 4)
  // FINISHED_LOT lines only: the bag's net (metal) weight off the supplier's invoice. `weight` is the
  // gross, so stone weight = weight - netWeight. Null on every other line.
  netWeight    Decimal?      @db.Decimal(10, 4)
  unit         String
  karat        String?
  ratePerUnit  Decimal       @db.Decimal(12, 4)
  totalAmount  Decimal       @db.Decimal(12, 2)
  receivedQty  Decimal       @default(0) @db.Decimal(10, 4)
  receivedWt   Decimal       @default(0) @db.Decimal(10, 4)

  // Input GST on this line, as charged on the supplier's bill. taxRate is a snapshot taken at PO
  // time (like InvoiceItem.taxRate on the sell side) — a later HsnCode rate change never silently
  // reprices a past purchase. 0 = no GST on the bill (unregistered supplier, or non-INR PO).
  hsnCode   HsnCode? @relation(fields: [hsnCodeId], references: [id])
  hsnCodeId String?
  taxRate   Decimal  @default(0) @db.Decimal(5, 4)

  // G2g-7a: the statutory classification of this line's supply (shared/taxCategory.ts: TAXABLE |
  // EXEMPT | NIL_RATED | NON_GST | ZERO_RATED) — decided at the same time as hsnCodeId/taxRate
  // above (PO entry) and for the same reason: a later master change must never reinterpret what
  // an already-placed order was. Deliberately NOT inferred from taxRate — a 0% rate and an
  // EXEMPT/NIL_RATED/NON_GST/ZERO_RATED supply are distinct statutory facts (see that module's own
  // header). Nullable: every PoItem created before this column exists is left unassigned, never
  // guessed from its taxRate; createPO defaults a newly-created line to TAXABLE only when the
  // caller omits the field outright.
  taxCategory String?

  // G2g-7d: explicit, line-level RCM (reverse-charge) category for this supply —
  // shared/rcmCategory.ts. Decided at PO entry, exactly like taxCategory above, and for the
  // identical reason: RCM liability is a property of the specific notified supply, never inferred
  // from the supplier's registration status (CGST Act §9(4)'s blanket unregistered-supplier RCM
  // has been suspended since Feb 2019 — see PHASE_G2G7D_AUDIT.md §B.2) or from a blank gstNumber.
  // Nullable — every existing row is left unassigned; createPO defaults a newly-created line with
  // no explicit value to 'NONE' (RCM_NOT_APPLICABLE), never guessed.
  rcmCategory String?

  grnItems   GrnItem[]
  // FINISHED_LOT lines only: what is in the bag, category by category (see PoItemCategory).
  categories PoItemCategory[]
  // The agreed cost rate of each stone/pearl/bead component this line's pieces carry (see PoItemComponent).
  components PoItemComponent[]

  // composite-FK target: lets the database refuse a child that points at another company's PoItem
  @@unique([id, companyId])
  @@index([companyId])
  @@map("po_items")
}

// One category's share of a FINISHED_LOT bag, as the supplier's invoice states it: e.g. Rings, 22K, gross
// 40.000 g, stone 4.000 g, net 36.000 g, 12 pieces. A bag line carries one row per category (and per karat —
// a karat is individual to its row). Gross/stone/net are the invoice's; pieces is optional (a supplier that
// doesn't state a count leaves it null, and only the weights are tracked). Tagging a piece out of the bag
// checks it against the row for its category (shared/purchaseLot.ts); the bag's cost, though, is one amount
// on the line and is split across the pieces by net weight, not per category.
model PoItemCategory {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  poItem      PoItem          @relation(fields: [poItemId, companyId], references: [id, companyId], onDelete: Cascade)
  poItemId    String
  category    ProductCategory @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)
  categoryId  String
  karat       String
  grossWeight Decimal         @db.Decimal(10, 4)
  stoneWeight Decimal         @default(0) @db.Decimal(10, 4)
  netWeight   Decimal         @db.Decimal(10, 4)
  pieces      Int?
  // Cost rates for this category, entered ONCE on the PO and pre-filled on every tag cut from it (each tag
  // may still change them): metal cost ₹ per gram of net weight, making charge ₹ per gram, value-addition %
  // of the metal value — the same three inputs the tag's Materials and MC & VA tabs take. All optional.
  costRate    Decimal?        @db.Decimal(12, 4)
  mcRate      Decimal?        @db.Decimal(12, 4)
  vaPercent   Decimal?        @db.Decimal(5, 2)

  @@unique([poItemId, categoryId, karat])
  @@index([companyId])
  @@index([categoryId])
  @@map("po_item_categories")
}

model GoodsReceiptNote {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  grnNumber     String
  po            PurchaseOrder @relation(fields: [poId, companyId], references: [id, companyId])
  poId          String
  receivedDate  DateTime
  invoiceNumber String?
  invoiceDate   DateTime?
  status        String        @default("PENDING")
  verifiedBy    String?
  verifiedAt    DateTime?
  notes         String?
  createdAt     DateTime      @default(now())

  // Receiving branch — required for FINISHED_GOODS lines, since those become a
  // JewelryTag at a specific branch. Nullable so existing raw-material GRNs are unaffected.
  branchId String?
  branch   Branch? @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)

  grnItems   GrnItem[]
  debitNotes DebitNote[]

  @@unique([companyId, grnNumber])
  // composite-FK target: lets the database refuse a child that points at another company's GoodsReceiptNote
  @@unique([id, companyId])
  @@index([companyId])
  @@index([branchId])
  // Phase 4 Part N: reports.router.ts's dashboard "today's GRNs" count filters by
  // companyId+createdAt.
  @@index([companyId, createdAt])
  @@map("goods_receipt_notes")
}

model GrnItem {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  grn             GoodsReceiptNote @relation(fields: [grnId, companyId], references: [id, companyId], onDelete: Cascade)
  grnId           String
  poItem          PoItem           @relation(fields: [poItemId, companyId], references: [id, companyId])
  poItemId        String
  invoiceQty      Decimal          @db.Decimal(10, 4)
  invoiceWeight   Decimal          @db.Decimal(10, 4)
  scaleWeight     Decimal          @db.Decimal(10, 4)
  acceptedWeight  Decimal          @db.Decimal(10, 4)
  variance        Decimal          @db.Decimal(10, 4)
  variancePercent Decimal          @db.Decimal(5, 2)
  isVerified      Boolean          @default(false)
  batchNumber     String?

  // Back-reference for FINISHED_GOODS lines: the single JewelryTag this receipt became.
  jewelryTag  JewelryTag?
  // Back-reference for FINISHED_LOT lines: the lot (bag) this receipt opened, tagged piece by piece.
  purchaseLot PurchaseLot?

  // Input GST booked when this line was tagged into stock (createTagFromGrnItem): the taxable value
  // (= the tag's costPrice) and the CGST/SGST or IGST split, by supplier state vs company state.
  // Null/0 until tagged. This is what the purchase GST register reads, and what a purchase return
  // reverses — so it is written once, at intake, and never recomputed.
  taxableValue Decimal? @db.Decimal(12, 2)
  inputCgst    Decimal  @default(0) @db.Decimal(12, 2)
  inputSgst    Decimal  @default(0) @db.Decimal(12, 2)
  inputIgst    Decimal  @default(0) @db.Decimal(12, 2)

  // G2g-7a: which of the company's OWN GST registrations this inward supply is attributed to —
  // resolved from the GRN's receiving branch (else the company's primary active registration)
  // and stamped ONCE, at the exact moment the line's own taxableValue/inputCgst/Sgst/Igst above
  // are booked (createTagFromGrnItem for a FINISHED_GOODS line, openPurchaseLot for a
  // FINISHED_LOT line) — see resolveBuyerRegistration (shared/inputGst.ts). Never backfilled onto
  // an existing row and never re-resolved later even if the branch's registration subsequently
  // changes (same immutable-snapshot convention as TaxInvoice.sellerRegistrationId on the sell
  // side). Null for every line that predates this column, for a line whose tax event never ran
  // (a raw-material/other line that never books input GST at all), and for a company with no GST
  // registration configured — null is left as a fact, never guessed (CLAUDE.md §13).
  buyerRegistrationId String?
  buyerRegistration   CompanyGstRegistration? @relation(fields: [buyerRegistrationId, companyId], references: [id, companyId])

  // G2g-7d: the self-assessed RCM liability this line produced, if its PoItem.rcmCategory
  // classified as RCM_APPLICABLE. Null for the overwhelming majority of lines (rcmCategory NONE).
  rcmLiability RcmLiability?

  // Snapshot of the PO's component cost rates taken when this line was received (see GrnItemComponentRate).
  componentRates GrnItemComponentRate[]

  // composite-FK target: lets the database refuse a lot that points at another company's GrnItem
  @@unique([id, companyId])
  @@index([companyId])
  @@index([buyerRegistrationId])
  @@map("grn_items")
}

// A supplier's standing cost rate for a stone/pearl/bead component (a StoneType, optionally narrowed to a
// StoneGrade variant/quality) in a unit — e.g. Diamond / VS / CT = 30,000. It is only the DEFAULT a new PO line
// starts from: the PO's own rate (PoItemComponent) is what is agreed for that purchase, and changing or retiring a
// vendor rate here never touches an existing PO or GRN. Among the active rows for one supplier+stone+grade+unit
// the one with the latest effectiveDate on or before the PO date applies; two with the same latest date are
// ambiguous and are reported, never picked between (shared/vendorRates.ts).
model VendorComponentRate {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  supplierId     String
  supplier       Supplier      @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  // A component is EITHER a stone (stoneTypeId, optionally narrowed by stoneGradeId) OR a Material Code (materialCodeId) —
  // exactly one, enforced by a CHECK constraint (see migration 20261003150000).
  stoneTypeId    String?
  stoneType      StoneType?    @relation(fields: [stoneTypeId, companyId], references: [id, companyId], onDelete: Restrict)
  stoneGradeId   String?
  stoneGrade     StoneGrade?   @relation(fields: [stoneGradeId, companyId], references: [id, companyId], onDelete: Restrict)
  materialCodeId String?
  materialCode   MaterialCode? @relation(fields: [materialCodeId, companyId], references: [id, companyId], onDelete: Restrict)
  unit           String        @default("CT")
  costRate       Decimal       @db.Decimal(12, 4)
  effectiveDate  DateTime      @default(now())
  isActive       Boolean       @default(true)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId])
  @@index([supplierId, stoneTypeId])
  @@index([supplierId, materialCodeId])
  @@map("vendor_component_rates")
}

// The cost rate agreed ON THIS PO for one component its pieces carry. Copied from the vendor's standing rate when
// the buyer did not type one (rateSource VENDOR_MASTER) or entered/overridden by the buyer (MANUAL); either way it
// is the purchase's own figure and later vendor-rate edits never reach it.
model PoItemComponent {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  poItem         PoItem        @relation(fields: [poItemId, companyId], references: [id, companyId], onDelete: Cascade)
  poItemId       String
  stoneTypeId    String?
  stoneType      StoneType?    @relation(fields: [stoneTypeId, companyId], references: [id, companyId], onDelete: Restrict)
  stoneGradeId   String?
  stoneGrade     StoneGrade?   @relation(fields: [stoneGradeId, companyId], references: [id, companyId], onDelete: Restrict)
  materialCodeId String?
  materialCode   MaterialCode? @relation(fields: [materialCodeId, companyId], references: [id, companyId], onDelete: Restrict)
  unit           String        @default("CT")
  costRate       Decimal       @db.Decimal(12, 4)
  rateSource     String        @default("MANUAL") // VENDOR_MASTER | MANUAL

  @@index([companyId])
  @@index([poItemId])
  @@map("po_item_components")
}

// Historical snapshot of the PO's component rates, written when the GRN line is received and never recomputed.
// Tagging a piece out of the received goods reads THESE rows, so a later PO edit or vendor-rate change can't
// reprice goods already received.
model GrnItemComponentRate {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  grnItem        GrnItem       @relation(fields: [grnItemId, companyId], references: [id, companyId], onDelete: Cascade)
  grnItemId      String
  stoneTypeId    String?
  stoneType      StoneType?    @relation(fields: [stoneTypeId, companyId], references: [id, companyId], onDelete: Restrict)
  stoneGradeId   String?
  stoneGrade     StoneGrade?   @relation(fields: [stoneGradeId, companyId], references: [id, companyId], onDelete: Restrict)
  materialCodeId String?
  materialCode   MaterialCode? @relation(fields: [materialCodeId, companyId], references: [id, companyId], onDelete: Restrict)
  unit           String        @default("CT")
  costRate       Decimal       @db.Decimal(12, 4)

  @@index([companyId])
  @@index([grnItemId])
  @@map("grn_item_component_rates")
}

// A bag of finished pieces bought on ONE supplier invoice line (a category's worth: e.g. 14 rings, 22K,
// 110.300 g net, ₹3,20,000) and tagged one piece at a time afterwards. Opened by createGRN when a
// FINISHED_LOT PO line is received — that is also when the payable and input GST are booked (the whole
// bill is owed the moment the goods arrive, not as each piece happens to get tagged), so tagging a piece
// out of a lot moves no money: it only allocates a share of `totalCost` to that tag's costPrice.
// What has been tagged so far is never stored as a counter — it is the live sum over the lot's tags, so a
// later weight correction on a tag can't leave a stale total behind. `version` is only a row-lock token.
model PurchaseLot {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  grnItemId   String    @unique
  grnItem     GrnItem   @relation(fields: [grnItemId, companyId], references: [id, companyId], onDelete: Restrict)
  label       String // the PO line's material name, e.g. "22K Gold Rings"
  karat       String? // legacy single-karat lots only; a bag's karats live on its category rows
  pieces      Int? // total piece count — only when every category row states one
  grossWeight Decimal   @db.Decimal(10, 4)
  netWeight   Decimal   @db.Decimal(10, 4)
  totalCost   Decimal   @db.Decimal(12, 2) // taxable value of the whole lot; GST is on grn_items
  status      String    @default("OPEN") // OPEN | CLOSED
  closedAt    DateTime?
  closeNote   String?
  version     Int       @default(0)
  createdAt   DateTime  @default(now())

  tags JewelryTag[]

  @@unique([grnItemId, companyId])
  // composite-FK target: lets the database refuse a tag that points at another company's lot
  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("purchase_lots")
}

// ═══════════════════════════════════════════════════
// MODULE 3: INVENTORY & DIAMOND ASSORTMENT
// ═══════════════════════════════════════════════════

// companyId direct — Phase 3. A company's own physical metal vault (live: D4 old-gold-exchange
// already writes here today, not just dormant manufacturing).
model MetalStock {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  stockCode      String
  materialName   String
  karat          String
  purity         Decimal  @db.Decimal(6, 4)
  grossWeight    Decimal  @db.Decimal(12, 4)
  netWeight      Decimal  @db.Decimal(12, 4)
  availableWt    Decimal  @db.Decimal(12, 4)
  location       String?
  sourceType     String
  sourceRef      String?
  avgCostPerGram Decimal  @db.Decimal(12, 4)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reservations    MaterialReservation[]
  oldGoldExchange OldGoldExchange?
  movements       MetalStockMovement[]

  @@unique([companyId, stockCode])
  // composite-FK target: lets the database refuse a movement pointing at another company's vault lot
  @@unique([id, companyId])
  @@index([companyId])
  @@index([karat])
  @@index([location])
  @@map("metal_stocks")
}

// Append-only ledger of every change to a Metal Vault lot's availableWt that the sell/buy-back flows make — one row per
// lot touched, so a sale that drains two lots writes two rows. `quantity` is signed (negative = out of the vault) and
// before/after are the lot's availableWt around the change. (referenceType, referenceId) says WHAT caused it — an
// InvoiceItem for a material sale, a SalesReturnItem for its return, an OldGoldExchange for a customer purchase — and the
// unique key below is the idempotency guard: the same cause can never move the same lot, in the same way, twice.
// `reversesMovementId` ties a return/reversal back to the exact movement it undoes, so it can restore the SAME lot at
// the SAME cost. `unitCostPerGram` snapshots the lot's avgCostPerGram at the time (for the COGS/inventory entries).
model MetalStockMovement {
  id                 String     @id @default(cuid())
  companyId          String
  company            Company    @relation(fields: [companyId], references: [id])
  branchId           String?
  branch             Branch?    @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  metalStockId       String
  metalStock         MetalStock @relation(fields: [metalStockId, companyId], references: [id, companyId], onDelete: Restrict)
  // MATERIAL_SALE | MATERIAL_SALE_RETURN | CUSTOMER_PURCHASE | CUSTOMER_PURCHASE_REVERSAL | OLD_GOLD_EXCHANGE |
  // OLD_GOLD_EXCHANGE_REVERSAL | MANUAL_ADD (shared/metalMovement.ts)
  movementType       String
  referenceType      String
  referenceId        String
  reversesMovementId String?
  materialName       String
  karat              String
  purity             Decimal    @db.Decimal(6, 4)
  quantity           Decimal    @db.Decimal(12, 4)
  beforeAvailableWt  Decimal    @db.Decimal(12, 4)
  afterAvailableWt   Decimal    @db.Decimal(12, 4)
  unitCostPerGram    Decimal    @db.Decimal(12, 4)
  userId             String?
  createdAt          DateTime   @default(now())

  @@unique([companyId, movementType, referenceType, referenceId, metalStockId])
  @@index([companyId, createdAt])
  @@index([companyId, metalStockId])
  @@index([companyId, referenceType, referenceId])
  @@map("metal_stock_movements")
}

// A customer's old/used gold piece taken in and valued (D4) — credits the customer's own balance
// (Client.currentBalance, same field a sale debits and a SalesReturn credits) as a standing store
// credit redeemable against any future purchase, and adds the melted-down weight to the Metal
// Vault (MetalStock, via the existing addMetalStock()) so the metal itself is tracked.
model OldGoldExchange {
  id               String      @id @default(cuid())
  // Denormalized from clientId (Client is company-owned) — Phase 2 of the multi-tenant
  // migration. Stamped from the authenticated tenant context, always cross-checked against
  // the resolved client's own companyId at write time (see sales.service.ts).
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id])
  exchangeNumber   String
  client           Client      @relation(fields: [clientId, companyId], references: [id, companyId])
  clientId         String
  exchangeDate     DateTime    @default(now())
  description      String
  karat            String
  grossWeight      Decimal     @db.Decimal(10, 4)
  stoneWeight      Decimal     @default(0) @db.Decimal(10, 4)
  netWeight        Decimal     @db.Decimal(10, 4)
  // MetalRate snapshot at exchangeDate — like costPrice on JewelryTag, a later rate change must
  // not silently reprice a past exchange.
  ratePerGram      Decimal     @db.Decimal(12, 4)
  deductionPercent Decimal     @default(0) @db.Decimal(5, 2)
  valuedAmount     Decimal     @db.Decimal(12, 2)
  metalStockId     String?     @unique
  metalStock       MetalStock? @relation(fields: [metalStockId], references: [id])
  // Where the metal was taken in (null on rows from before this column).
  branchId         String?
  branch           Branch?     @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  // Set when the customer handed over a TAGGED piece (a previously sold JewelryTag): the tag is RETIRED by this
  // exchange (never deleted, never re-sold) and its metal is what enters the vault.
  tagId            String?
  tag              JewelryTag? @relation(fields: [tagId, companyId], references: [id, companyId], onDelete: Restrict)
  notes            String?
  createdAt        DateTime    @default(now())
  // J3 Decision 2: reversing an OLD_GOLD-settled InvoicePayment must reverse this exchange too, in
  // the same transaction (currentBalance credit, the Metal Vault addition, and the journal) — see
  // reverseInvoicePayment() in sales.service.ts. A reversed exchange can never fund a second
  // reversal (checked before either write).
  reversedAt       DateTime?
  reversedById     String?
  reversedBy       User?       @relation("ExchangeReversedBy", fields: [reversedById], references: [id])
  reversalReason   String?

  @@unique([companyId, exchangeNumber])
  @@index([companyId])
  @@index([tagId])
  @@map("old_gold_exchanges")
}

// companyId direct — Phase 3. A company's own physical stone/diamond inventory.
model StoneLot {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  lotNumber    String
  stoneType    String
  shape        String
  color        String?
  clarity      String?
  cut          String?
  caratWeight  Decimal  @db.Decimal(10, 4)
  pieces       Int
  sieveSize    String?
  certNumber   String?
  certLab      String?
  avgCostPerCt Decimal  @db.Decimal(12, 4)
  totalCost    Decimal  @db.Decimal(12, 2)
  availableCts Decimal  @db.Decimal(10, 4)
  availablePcs Int
  location     String?
  status       String   @default("AVAILABLE")
  sourceRef    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentSplits StoneLotSplit[]       @relation("ParentLot")
  childSplits  StoneLotSplit[]       @relation("ChildLot")
  reservations MaterialReservation[]

  @@unique([companyId, lotNumber])
  @@index([companyId])
  @@index([stoneType, status])
  @@map("stone_lots")
}

model StoneLotSplit {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  parentLot   StoneLot @relation("ParentLot", fields: [parentLotId], references: [id])
  parentLotId String
  childLot    StoneLot @relation("ChildLot", fields: [childLotId], references: [id])
  childLotId  String
  splitWeight Decimal  @db.Decimal(10, 4)
  splitPieces Int
  splitDate   DateTime @default(now())
  reason      String?

  @@index([companyId])
  @@map("stone_lot_splits")
}

// companyId direct — Phase 3. A company's own consumable-supplies inventory.
model Consumable {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  itemCode     String
  name         String
  category     String
  currentQty   Decimal  @db.Decimal(12, 4)
  unit         String
  reorderLevel Decimal  @db.Decimal(12, 4)
  location     String?
  avgCost      Decimal? @db.Decimal(12, 4)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  transactions ConsumableTransaction[]

  @@unique([companyId, itemCode])
  @@index([companyId])
  @@map("consumables")
}

model ConsumableTransaction {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  consumable   Consumable @relation(fields: [consumableId], references: [id])
  consumableId String
  type         String
  quantity     Decimal    @db.Decimal(12, 4)
  balanceAfter Decimal    @db.Decimal(12, 4)
  reference    String?
  notes        String?
  createdAt    DateTime   @default(now())

  @@index([companyId])
  @@map("consumable_transactions")
}

// ═══════════════════════════════════════════════════
// MODULE 4: ORDER MANAGEMENT & MATERIAL RESERVATION
// ═══════════════════════════════════════════════════

model Client {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  clientCode     String
  name           String
  type           String
  gstNumber      String?
  panNumber      String?
  // Date of birth (date only) — captured at the estimate's "send to billing" hand-off; optional everywhere.
  dateOfBirth    DateTime? @db.Date
  // Form 60 (the declaration a customer with no PAN gives instead) is on file. With panNumber, this is
  // what lets a sale over ₹2,00,000 go through — see shared/compliance.ts assertPanIfRequired.
  form60Received Boolean   @default(false)
  // "Door No" — the building/house/flat line of the address; street/area beyond that still
  // has nowhere else to go, so it stays folded in here too, same as before this pair existed.
  address        String?
  city           String?
  district       String?
  state          String?
  pincode        String?
  country        String    @default("India")
  phone          String?
  email          String?
  contactPerson  String?
  creditLimit    Decimal?  @db.Decimal(12, 2)
  currentBalance Decimal   @default(0) @db.Decimal(12, 2)
  pricingTier    String    @default("STANDARD")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  salesOrders      SalesOrder[]
  memoOuts         MemoOut[]
  salesInvoices    SalesInvoice[]
  salesReturns     SalesReturn[]
  oldGoldExchanges OldGoldExchange[]
  payments         InvoicePayment[]
  repairJobs       RepairJob[]
  manufacturedTags JewelryTag[]
  creditNotes      CreditNote[]
  salesDebitNotes  SalesDebitNote[]

  @@unique([companyId, clientCode])
  // composite-FK target: lets the database refuse a child that points at another company's Client
  @@unique([id, companyId])
  @@index([companyId])
  @@map("clients")
}

// companyId direct — Phase 3. SalesOrder is a PRODUCTION order (CLAUDE.md: not a retail/
// wholesale sale — do not use it for counter/dealer selling), dormant, but scoped for
// architectural completeness. Denormalized from Client, same reasoning as everywhere else.
model SalesOrder {
  id                  String    @id @default(cuid())
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  orderNumber         String
  client              Client    @relation(fields: [clientId], references: [id])
  clientId            String
  orderDate           DateTime
  deliveryDate        DateTime?
  priority            String    @default("NORMAL")
  status              String    @default("PENDING")
  specialInstructions String?
  advanceAmount       Decimal   @default(0) @db.Decimal(12, 2)
  advanceType         String?
  advanceRef          String?
  totalEstimated      Decimal?  @db.Decimal(12, 2)
  currency            String    @default("INR")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orderItems    OrderItem[]
  reservations  MaterialReservation[]
  notifications ClientNotification[]
  jobCards      JobCard[]

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([status, orderDate])
  @@map("sales_orders")
}

model OrderItem {
  id             String     @id @default(cuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id])
  order          SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  design         Design     @relation(fields: [designId], references: [id])
  designId       String
  quantity       Int
  customizations Json?
  referencePhoto String?
  unitPrice      Decimal    @db.Decimal(12, 2)
  totalPrice     Decimal    @db.Decimal(12, 2)
  status         String     @default("PENDING")

  jobCards JobCard[]

  @@index([companyId])
  @@map("order_items")
}

model MaterialReservation {
  id              String      @id @default(cuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id])
  order           SalesOrder  @relation(fields: [orderId], references: [id])
  orderId         String
  reservationType String
  metalStock      MetalStock? @relation(fields: [metalStockId], references: [id])
  metalStockId    String?
  stoneLot        StoneLot?   @relation(fields: [stoneLotId], references: [id])
  stoneLotId      String?
  reservedWeight  Decimal     @db.Decimal(10, 4)
  reservedPieces  Int?
  status          String      @default("ACTIVE")
  reservedAt      DateTime    @default(now())

  @@index([companyId])
  @@map("material_reservations")
}

model ClientNotification {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  order     SalesOrder @relation(fields: [orderId], references: [id])
  orderId   String
  type      String
  milestone String
  message   String
  phone     String?
  email     String?
  sentAt    DateTime?
  status    String     @default("PENDING")
  error     String?

  @@index([companyId])
  @@map("client_notifications")
}

// ═══════════════════════════════════════════════════
// MODULE 5: IN-HOUSE MANUFACTURING & WIP
// ═══════════════════════════════════════════════════

// companyId direct — Phase 3. Dormant (manufacturing), scoped for architectural completeness.
model JobCard {
  id             String      @id @default(cuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  jobNumber      String
  order          SalesOrder? @relation(fields: [orderId], references: [id])
  orderId        String?
  orderItem      OrderItem?  @relation(fields: [orderItemId], references: [id])
  orderItemId    String?
  design         Design      @relation(fields: [designId], references: [id])
  designId       String
  batchSize      Int         @default(1)
  jobType        String      @default("PRODUCTION")
  status         String      @default("CREATED")
  rfidTag        String?     @unique
  barcodeData    String?     @unique
  issuedWeight   Decimal     @db.Decimal(10, 4)
  returnedWeight Decimal     @default(0) @db.Decimal(10, 4)
  scrapWeight    Decimal     @default(0) @db.Decimal(10, 4)
  netWeight      Decimal?    @db.Decimal(10, 4)
  currentProcess String?
  priority       String      @default("NORMAL")
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  processes        JobProcess[]
  wipTracking      WipTracking[]
  qcCheckpoints    QcCheckpoint[]
  repairJobs       RepairJob[]
  hallmarkingItems HallmarkingItem[]
  jewelryTags      JewelryTag[]

  @@unique([companyId, jobNumber])
  @@index([companyId])
  @@index([status])
  // Phase 4 Part N: covers reports.router.ts's dashboard/wip-summary counts and
  // manufacturing.service.ts's getFactoryFloorStatus — all filter by companyId+status together.
  @@index([companyId, status])
  @@map("job_cards")
}

model JobProcess {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  jobCard         JobCard   @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  jobCardId       String
  processName     String
  sequence        Int
  assignedArtisan String?
  workstation     String?
  status          String    @default("PENDING")
  startTime       DateTime?
  endTime         DateTime?
  issuedWeight    Decimal?  @db.Decimal(10, 4)
  returnedWeight  Decimal?  @db.Decimal(10, 4)
  lossWeight      Decimal?  @db.Decimal(10, 4)
  lossPercent     Decimal?  @db.Decimal(5, 2)
  notes           String?

  wipEntries   WipTracking[]
  qcCheckpoint QcCheckpoint?

  @@index([companyId])
  @@map("job_processes")
}

model WipTracking {
  id             String     @id @default(cuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id])
  jobCard        JobCard    @relation(fields: [jobCardId], references: [id])
  jobCardId      String
  process        JobProcess @relation(fields: [processId], references: [id])
  processId      String
  worker         User       @relation(fields: [workerId], references: [id])
  workerId       String
  issuedWeight   Decimal    @db.Decimal(10, 4)
  returnedWeight Decimal    @default(0) @db.Decimal(10, 4)
  scrapWeight    Decimal    @default(0) @db.Decimal(10, 4)
  lossWeight     Decimal    @default(0) @db.Decimal(10, 4)
  lossPercent    Decimal    @default(0) @db.Decimal(5, 2)
  scaleReading   Decimal?   @db.Decimal(10, 4)
  deviceId       String?
  timestamp      DateTime   @default(now())

  @@index([companyId])
  @@index([jobCardId, processId])
  @@map("wip_tracking")
}

model QcCheckpoint {
  id            String     @id @default(cuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  jobCard       JobCard    @relation(fields: [jobCardId], references: [id])
  jobCardId     String
  process       JobProcess @relation(fields: [processId], references: [id])
  processId     String     @unique
  inspector     User       @relation(fields: [inspectorId], references: [id])
  inspectorId   String
  result        String
  checklistData Json?
  defects       Json?
  stoneCount    Int?
  stoneSecure   Boolean    @default(true)
  notes         String?
  signedAt      DateTime   @default(now())

  @@index([companyId])
  @@map("qc_checkpoints")
}

// ═══════════════════════════════════════════════════
// MODULE 6: OUTSOURCING & JOB WORK CONTROL
// ═══════════════════════════════════════════════════

// companyId direct — Phase 3. A karigar (subcontractor) is a company's own labour relationship —
// same private-business-relationship class as Supplier/Client. Dormant (outsourcing module).
model Artisan {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  artisanCode     String
  name            String
  type            String
  specializations String[]
  phone           String?
  address         String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  supplierId      String?
  metalBalance    Decimal   @default(0) @db.Decimal(10, 4)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  ledgerEntries KarigarLedger[]
  invoices      SubcontractorInvoice[]

  @@unique([companyId, artisanCode])
  @@index([companyId])
  @@map("artisans")
}

model KarigarLedger {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  artisan         Artisan  @relation(fields: [artisanId], references: [id])
  artisanId       String
  date            DateTime
  transactionType String
  metalType       String
  karat           String?
  issuedWeight    Decimal  @default(0) @db.Decimal(10, 4)
  returnedWeight  Decimal  @default(0) @db.Decimal(10, 4)
  scrapWeight     Decimal  @default(0) @db.Decimal(10, 4)
  lossWeight      Decimal  @default(0) @db.Decimal(10, 4)
  lossPercent     Decimal  @default(0) @db.Decimal(5, 2)
  balanceAfter    Decimal  @db.Decimal(10, 4)
  jobCardRef      String?
  issuedBy        User     @relation("IssuedBy", fields: [issuedById], references: [id])
  issuedById      String
  notes           String?
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([artisanId, date])
  @@map("karigar_ledger")
}

// companyId direct — Phase 3. A manufacturing QC tolerance/wastage POLICY (max loss %, deduction
// rate) is a business decision each company sets for itself, not a universal engineering
// constant — same reasoning as MakingCharge, not KaratMaster.
model ProcessTolerance {
  id             String  @id @default(cuid())
  companyId      String
  company        Company @relation(fields: [companyId], references: [id])
  processName    String
  maxLossPercent Decimal @db.Decimal(5, 2)
  deductionRate  Decimal @db.Decimal(10, 4)
  alertThreshold Decimal @db.Decimal(5, 2)

  @@unique([companyId, processName])
  @@index([companyId])
  @@map("process_tolerances")
}

model SubcontractorInvoice {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  invoiceNumber String
  artisan       Artisan   @relation(fields: [artisanId], references: [id])
  artisanId     String
  invoiceDate   DateTime
  periodFrom    DateTime
  periodTo      DateTime
  chargeType    String
  grossAmount   Decimal   @db.Decimal(12, 2)
  deductions    Decimal   @default(0) @db.Decimal(12, 2)
  netPayable    Decimal   @db.Decimal(12, 2)
  status        String    @default("DRAFT")
  items         Json?
  paidAt        DateTime?
  paymentRef    String?
  notes         String?
  createdAt     DateTime  @default(now())

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@map("subcontractor_invoices")
}

// ═══════════════════════════════════════════════════
// MODULE 7: QUALITY ASSURANCE, REPAIRS & COMPLIANCE
// ═══════════════════════════════════════════════════

// companyId direct — Phase 2b. Required (no live data predates this migration — see CLAUDE.md —
// so there's no historical-row ambiguity to accommodate with a nullable column here).
model HallmarkingBatch {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  batchNumber String
  centerName  String
  sentDate    DateTime
  returnDate  DateTime?
  status      String    @default("SENT")
  itemCount   Int
  notes       String?
  createdAt   DateTime  @default(now())

  items HallmarkingItem[]

  @@unique([companyId, batchNumber])
  // composite-FK target: lets the database refuse a child that points at another company's HallmarkingBatch
  @@unique([id, companyId])
  @@index([companyId])
  @@map("hallmarking_batches")
}

// G2: a hallmarking item used to require a JobCard (manufacturing lineage), so a purchased
// finished-goods piece (no JobCard — see CLAUDE.md §3) could never be sent for hallmarking.
// jobCardId is now optional and tagId is the bought-in alternative; createHallmarkingBatch
// enforces "at least one of the two" at the app layer (no DB CHECK constraint — same style as
// every other optional-FK pair in this schema, e.g. JewelryTag.jobCardId/designId).
model HallmarkingItem {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  batch           HallmarkingBatch @relation(fields: [batchId, companyId], references: [id, companyId])
  batchId         String
  jobCard         JobCard?         @relation(fields: [jobCardId], references: [id])
  jobCardId       String?
  tag             JewelryTag?      @relation(fields: [tagId, companyId], references: [id, companyId], onDelete: Restrict)
  tagId           String?
  huid            String?
  bisStamp        String?
  karat           String
  netWeight       Decimal          @db.Decimal(10, 4)
  inscriptionCode String?
  isVerified      Boolean          @default(false)

  @@index([companyId])
  @@map("hallmarking_items")
}

// G1: extended for the post-pivot "customer brings a piece in to fix" flow, on top of the
// original manufacturing QC-failure/rework use. clientName/originalJobCardId are untouched
// (still free-text/optional, for that older flow) — clientId and tagId are the new, optional
// links to a real Client and the actual JewelryTag under repair. receivedDate/deliveredDate give
// explicit "in/out" tracking beyond the generic status string; invoiceId (set once billed via
// billRepairJob) makes charging idempotent — a repair can't be billed twice.
model RepairJob {
  id                String        @id @default(cuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id])
  repairNumber      String
  originalJobCard   JobCard?      @relation(fields: [originalJobCardId], references: [id])
  originalJobCardId String?
  client            Client?       @relation(fields: [clientId, companyId], references: [id, companyId], onDelete: Restrict)
  clientId          String?
  tag               JewelryTag?   @relation(fields: [tagId, companyId], references: [id, companyId], onDelete: Restrict)
  tagId             String?
  repairType        String
  returnReason      String
  clientName        String?
  status            String        @default("RECEIVED")
  additionalMetal   Decimal       @default(0) @db.Decimal(10, 4)
  metalRecovered    Decimal       @default(0) @db.Decimal(10, 4)
  repairCost        Decimal?      @db.Decimal(12, 2)
  estimatedDays     Int?
  receivedDate      DateTime      @default(now())
  deliveredDate     DateTime?
  invoice           SalesInvoice? @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Restrict)
  invoiceId         String?       @unique
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  transactions RepairTransaction[]

  @@unique([companyId, repairNumber])
  // the relation is one-to-one (invoiceId is @unique), so its composite-FK form needs a matching composite unique
  @@unique([invoiceId, companyId])
  @@index([companyId])
  @@map("repair_jobs")
}

model RepairTransaction {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id])
  repairJobId String
  type        String
  weight      Decimal?  @db.Decimal(10, 4)
  pieces      Int?
  costValue   Decimal?  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@map("repair_transactions")
}

// ═══════════════════════════════════════════════════
// MODULE 8: SALES, WHOLESALING & EXPORT
// ═══════════════════════════════════════════════════

model MemoOut {
  id             String   @id @default(cuid())
  // Direct, required — Phase 2 of the multi-tenant migration. branchId is stamped from the
  // branch the memo is physically sent out from (never inferred from a tag afterward — this
  // is exactly the fix for convertMemoToInvoice's earlier "derive branch from the first
  // resolved tag" workaround: the memo now carries its own branch from the moment it's
  // created, so conversion reads it directly instead of guessing).
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  branchId       String
  branch         Branch   @relation(fields: [branchId, companyId], references: [id, companyId])
  memoNumber     String
  client         Client   @relation(fields: [clientId, companyId], references: [id, companyId])
  clientId       String
  sentDate       DateTime
  returnDeadline DateTime
  status         String   @default("OUT")
  totalValue     Decimal  @default(0) @db.Decimal(12, 2)
  alertSent      Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items MemoItem[]

  @@unique([companyId, memoNumber])
  // composite-FK target: lets the database refuse a child that points at another company's MemoOut
  @@unique([id, companyId])
  @@index([companyId, branchId])
  @@index([status, returnDeadline])
  // Phase 4 Part N: checkMemoAlerts (sales.service.ts) queries exactly this shape scoped by
  // companyId (fixed to be company-scoped in Phase 4 Part D — see that function's own comment);
  // the existing (status, returnDeadline) index has no companyId prefix, so it can't narrow to one
  // company before scanning every company's OUT-status memos.
  @@index([companyId, status, returnDeadline])
  @@map("memo_outs")
}

model MemoItem {
  id             String      @id @default(cuid())
  // Denormalized from the parent MemoOut at create time.
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  memo           MemoOut     @relation(fields: [memoId, companyId], references: [id, companyId], onDelete: Cascade)
  memoId         String
  productCode    String
  description    String
  huid           String?
  karat          String?
  pieces         Int
  grossWeight    Decimal     @db.Decimal(10, 4)
  netGoldWeight  Decimal     @db.Decimal(10, 4)
  stoneWeight    Decimal     @default(0) @db.Decimal(10, 4)
  estimatedValue Decimal     @db.Decimal(12, 2)
  returnedPieces Int         @default(0)
  status         String      @default("OUT")
  tagId          String?
  tag            JewelryTag? @relation(fields: [tagId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId])
  @@map("memo_items")
}

model Branch {
  id                String                  @id @default(cuid())
  companyId         String
  company           Company                 @relation(fields: [companyId], references: [id])
  branchCode        String
  name              String
  address           String?
  city              String?
  state             String?
  phone             String?
  email             String?
  managerName       String?
  isHeadOffice      Boolean                 @default(false)
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  // G1 Part B: which GST registration this branch invoices under. Nullable — a branch with no
  // explicit link falls back to the company's primary active registration at invoice time
  // (resolveSellerRegistration() in sales.service.ts); every existing branch is backfilled to
  // its company's one migrated registration, so this is a pure addition, not a behavior change.
  gstRegistrationId String?
  gstRegistration   CompanyGstRegistration? @relation(fields: [gstRegistrationId, companyId], references: [id, companyId])

  tags                JewelryTag[]
  transfersFrom       BranchTransfer[]     @relation("FromBranch")
  transfersTo         BranchTransfer[]     @relation("ToBranch")
  goodsReceiptNotes   GoodsReceiptNote[]
  stockAudits         StockAudit[]
  branchAccess        UserBranchAccess[]
  hardwareDevices     HardwareDevice[]
  salesInvoices       SalesInvoice[]
  memoOuts            MemoOut[]
  oldGoldExchanges    OldGoldExchange[]
  metalStockMovements MetalStockMovement[]
  taxInvoiceTemplates TaxInvoiceTemplate[]
  creditNoteTemplates CreditNoteTemplate[]
  debitNoteTemplates  DebitNoteTemplate[]
  salesDebitNotes     SalesDebitNote[]
  repairCasesOrigin   RepairCase[]
  repairTransfersFrom RepairTransfer[] @relation("RepairTransferFrom")
  repairTransfersTo   RepairTransfer[] @relation("RepairTransferTo")
  tagRetags           TagRetag[]

  @@unique([companyId, branchCode])
  @@unique([id, companyId]) // composite-FK target for UserBranchAccess
  @@index([companyId])
  @@map("branches")
}

// A physical stock count for one branch (E3) — snapshots that branch's IN_STOCK tags as
// "expected," staff scan pieces to check them off. Report-only: closing an audit never mutates
// JewelryTag.status or branchId — a missing/unexpected finding is a fact recorded here for a
// person to act on later (e.g. via retireTag or a branch transfer), not an automatic side effect.
model StockAudit {
  id          String    @id @default(cuid())
  // Direct — Phase 2 of the multi-tenant migration. Denormalized from branchId (validated to
  // match at creation) so this table can be filtered/RLS'd without a join up to branches.
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  auditNumber String
  branch      Branch    @relation(fields: [branchId, companyId], references: [id, companyId])
  branchId    String
  status      String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  startedById String
  startedBy   User      @relation(fields: [startedById], references: [id])
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  notes       String?

  items StockAuditItem[]

  @@unique([companyId, auditNumber])
  // composite-FK target: lets the database refuse a child that points at another company's StockAudit
  @@unique([id, companyId])
  @@index([companyId, branchId])
  @@map("stock_audits")
}

model StockAuditItem {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  audit     StockAudit @relation(fields: [auditId, companyId], references: [id, companyId], onDelete: Cascade)
  auditId   String
  tag       JewelryTag @relation(fields: [tagId, companyId], references: [id, companyId])
  tagId     String
  // true = system expected this tag IN_STOCK at this branch when the audit started. A row with
  // expected=true, found=false at completion means "missing"; expected=false, found=true means
  // "found something the system didn't expect here" (wrong branch, or not IN_STOCK at all).
  expected  Boolean
  found     Boolean    @default(false)
  foundAt   DateTime?

  @@unique([auditId, tagId])
  @@index([companyId])
  @@map("stock_audit_items")
}

model JewelryTag {
  id             String           @id @default(cuid())
  // Direct, denormalized company ownership — NOT purely inferred through Branch. Every write
  // path (createTag, createTagFromGrnItem) stamps this from the authenticated tenant context,
  // and every read path filters on it explicitly (see tagging.service.ts) rather than trusting
  // a join through branchId alone. See the multi-tenant blueprint's RLS-denormalization rule.
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  tagNumber      String
  jobCardId      String?
  jobCard        JobCard?         @relation(fields: [jobCardId], references: [id])
  designId       String?
  design         Design?          @relation(fields: [designId], references: [id])
  // Purchase lineage for finished goods bought (not manufactured) into stock — one tag per GRN item.
  grnItemId      String?          @unique
  grnItem        GrnItem?         @relation(fields: [grnItemId], references: [id])
  // Purchase lineage for a piece tagged out of a bought-in lot (bag) — many tags per lot, unlike
  // grnItemId. costPrice on such a tag is its allocated share of the lot's cost, fixed at creation.
  purchaseLotId  String?
  purchaseLot    PurchaseLot?     @relation(fields: [purchaseLotId, companyId], references: [id, companyId], onDelete: Restrict)
  branchId       String
  branch         Branch           @relation(fields: [branchId, companyId], references: [id, companyId])
  name           String
  makeType       String           @default("GOLD")
  metalType      String
  metalKarat     String?
  grossWeight    Decimal          @db.Decimal(10, 4)
  netWeight      Decimal          @db.Decimal(10, 4)
  stoneWeight    Decimal          @default(0) @db.Decimal(10, 4)
  huid           String?
  settingType    String?
  costPrice      Decimal          @default(0) @db.Decimal(12, 2)
  sellingPrice   Decimal          @default(0) @db.Decimal(12, 2)
  // The making-charge rate (₹/gram) and VA/wastage% actually decided for this piece at tagging
  // time — auto-suggested from the MakingCharge master but overridable there, and the final,
  // possibly-overridden value is what gets saved here. Null only for tags that predate this column
  // (or came in via GRN intake, which has no MC/VA step) — every downstream consumer that reflects
  // this piece's price (Estimation, direct-invoice PER_GRAM pricing) must prefer these over a fresh
  // master lookup when present, so a later master-rate change never silently re-prices a piece an
  // executive already decided on.
  saleMcRate     Decimal?         @db.Decimal(12, 4)
  saleVaPercent  Decimal?         @db.Decimal(5, 2)
  // The MC & VA tab's Cost side (what was actually paid in labour/wastage, on top of the material
  // rows' own cost) — added so editing a tag can round-trip Cost Price exactly, the same way
  // saleMcRate/saleVaPercent already let Selling Price round-trip. Previously this pair only ever
  // existed inside the browser form: it got folded into costPrice at save time and then had
  // nowhere to be read back from, so re-opening a tag for edit always showed it blank, and saving
  // again (even for an unrelated field) silently dropped the markup back out of costPrice. Null
  // for tags created before this column (or via GRN intake, which has no MC/VA step at all).
  costMcRate     Decimal?         @db.Decimal(12, 4)
  costVaPercent  Decimal?         @db.Decimal(5, 2)
  status         String           @default("IN_STOCK")
  notes          String?
  // Nullable at the DB level only for backward compatibility with tags created before this
  // existed — application code requires both this and categoryId for every new tag (see
  // createTag/createTagFromGrnItem), since the tag number format depends on both codes.
  stockTypeId    String?
  stockType      StockType?       @relation(fields: [stockTypeId, companyId], references: [id, companyId], onDelete: Restrict)
  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)
  subCategoryId  String?
  subCategory    SubCategory?     @relation(fields: [subCategoryId, companyId], references: [id, companyId], onDelete: Restrict)
  collectionId   String?
  collection     Collection?      @relation(fields: [collectionId, companyId], references: [id, companyId], onDelete: Restrict)
  // Size from the Size master (ring size, bangle size...) — optional, only for categories where it applies.
  sizeId         String?
  size           Size?            @relation(fields: [sizeId, companyId], references: [id, companyId], onDelete: Restrict)
  // Number of physical pieces this one tag covers (e.g. a pair of earrings = 2). Null on tags that predate it.
  noOfPcs        Int?
  // Which vendor/manufacturer this piece was sourced from — a Client (type "MANUFACTURER"),
  // reusing the party master rather than a separate table (CLAUDE.md: reuse and extend).
  manufacturerId String?
  manufacturer   Client?          @relation(fields: [manufacturerId, companyId], references: [id, companyId], onDelete: Restrict)
  createdById    String
  createdBy      User             @relation("TagCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  memoItems           MemoItem[]
  transferItems       BranchTransferItem[]
  materials           JewelryTagMaterial[]
  // A tag can appear on more than one InvoiceItem over its lifetime — sold, then returned (D1)
  // flips it back to IN_STOCK, then it can be sold again on a later invoice. No longer 1:1.
  invoiceItems        InvoiceItem[]
  salesReturnItems    SalesReturnItem[]
  oldGoldExchanges    OldGoldExchange[]
  purchaseReturnItems PurchaseReturnItem[]
  stockAuditItems     StockAuditItem[]
  repairJobs          RepairJob[]
  repairCases         RepairCase[]
  retaggedFrom        TagRetag?        @relation("RetagOld")
  retaggedTo          TagRetag?        @relation("RetagNew")
  hallmarkingItems    HallmarkingItem[]
  estimates           TagEstimate[]

  @@unique([companyId, tagNumber])
  // composite-FK target: lets the database refuse a child that points at another company's JewelryTag
  @@unique([id, companyId])
  @@index([companyId, branchId, status])
  @@index([status])
  @@index([branchId])
  @@index([purchaseLotId])
  @@map("jewelry_tags")
}

model BranchTransfer {
  id             String    @id @default(cuid())
  // Direct — Phase 2. Both fromBranch/toBranch are additionally, explicitly validated at the
  // service layer to belong to this SAME companyId (a same-company-on-both-ends invariant no
  // FK alone can express) — see tagging.service.ts: createTransfer().
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  transferNumber String
  fromBranchId   String
  fromBranch     Branch    @relation("FromBranch", fields: [fromBranchId, companyId], references: [id, companyId])
  toBranchId     String
  toBranch       Branch    @relation("ToBranch", fields: [toBranchId, companyId], references: [id, companyId])
  status         String    @default("DRAFT")
  requestedById  String
  requestedBy    User      @relation("TransferRequester", fields: [requestedById], references: [id])
  approvedById   String?
  approvedBy     User?     @relation("TransferApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  dispatchedAt   DateTime?
  receivedAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items BranchTransferItem[]

  @@unique([companyId, transferNumber])
  // composite-FK target: lets the database refuse a child that points at another company's BranchTransfer
  @@unique([id, companyId])
  @@index([companyId])
  @@index([status])
  @@map("branch_transfers")
}

model BranchTransferItem {
  id         String         @id @default(cuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id])
  transfer   BranchTransfer @relation(fields: [transferId, companyId], references: [id, companyId], onDelete: Cascade)
  transferId String
  tag        JewelryTag     @relation(fields: [tagId, companyId], references: [id, companyId])
  tagId      String
  // Set when the receiving branch verified this piece and took it in. A dispatched transfer is
  // received piece by piece — an item with no receivedAt is still in transit.
  receivedAt DateTime?

  @@index([companyId])
  @@map("branch_transfer_items")
}

// ═══════════════════════════════════════════════════
// MASTERS — Reference Data
// ═══════════════════════════════════════════════════

model ProductCategory {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  subCategoryLinks CategorySubCategory[]
  jewelryTags      JewelryTag[]
  makingCharges    MakingCharge[]
  invoiceItems     InvoiceItem[]
  poItemCategories PoItemCategory[]
  sizes            Size[]

  @@unique([companyId, code])
  // composite-FK target: lets the database refuse a child that points at another company's ProductCategory
  @@unique([id, companyId])
  @@index([companyId])
  @@map("product_categories")
}

// A sub-category is ONE company-owned master (e.g. "Traditional") that can be linked to many categories
// through CategorySubCategory. Renaming it renames it everywhere it is used. JewelryTag keeps a plain
// subCategoryId; the (categoryId, subCategoryId) pair on a tag must be a CategorySubCategory link
// (enforced in the tagging service — the tag row itself is not a composite FK to the link table so a
// later unlink can be refused instead of cascading).
model SubCategory {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  jewelryTags   JewelryTag[]
  categoryLinks CategorySubCategory[]

  @@unique([companyId, code])
  // composite-FK target: lets the database refuse a child that points at another company's SubCategory
  @@unique([id, companyId])
  @@index([companyId])
  @@map("sub_categories")
}

// Category <-> SubCategory (many-to-many). Both sides are composite FKs on companyId, so the database
// itself refuses a link between two different companies' rows. Restrict, never Cascade: a master cannot
// be deleted from under its links, and unlinking is an explicit service operation.
model CategorySubCategory {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  categoryId    String
  category      ProductCategory @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)
  subCategoryId String
  subCategory   SubCategory     @relation(fields: [subCategoryId, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt     DateTime        @default(now())

  @@unique([companyId, categoryId, subCategoryId])
  @@index([companyId, subCategoryId])
  @@map("category_sub_categories")
}

// A size a piece can carry (ring size, bangle size, chain length...). categoryId is optional: set,
// the size is offered only for that category on New Tag; unset, it is offered for every category.
model Size {
  id         String           @id @default(cuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id])
  code       String
  name       String
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())

  jewelryTags JewelryTag[]

  @@unique([companyId, code])
  // composite-FK target: lets the database refuse a tag that points at another company's Size
  @@unique([id, companyId])
  @@index([companyId])
  @@map("sizes")
}

// A stone/metal setting style (prong, bezel, pave...) offered on New Tag. JewelryTag.settingType
// stays free text (stores the chosen name), so retiring or renaming a master row never rewrites a tag.
model SettingType {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId])
  @@map("setting_types")
}

model Collection {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  jewelryTags JewelryTag[]

  @@unique([companyId, code])
  // composite-FK target: lets the database refuse a child that points at another company's Collection
  @@unique([id, companyId])
  @@index([companyId])
  @@map("collections")
}

model MaterialCode {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  code         String
  name         String
  materialType String
  // Karat/purity this material code represents (KaratMaster.code convention, e.g. "22K" for a
  // "G22" gold code) — only meaningful for materialType "METAL". Free-text string, not a FK, to
  // match every other karat field in the app (JewelryTag.metalKarat, InvoiceItem.karat). Drives
  // two things: NewTagPage.tsx auto-derives the tag's own metalKarat from whichever METAL
  // material row carries the most weight, and MakingCharge resolution matches on it (see
  // MakingCharge.karat) so wastage/VA can vary by karat, not just by category.
  karat        String?
  unit         String   @default("GM")
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  tagMaterials      JewelryTagMaterial[]
  makingCharges     MakingCharge[]
  vendorRates       VendorComponentRate[]
  poComponents      PoItemComponent[]
  grnComponentRates GrnItemComponentRate[]

  @@unique([companyId, code])
  // composite-FK target: lets the database refuse a child that points at another company's MaterialCode
  @@unique([id, companyId])
  @@index([companyId])
  @@map("material_codes")
}

model HsnCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  gstRate     Decimal  @db.Decimal(5, 4)
  isActive    Boolean  @default(true)
  // G2g-3a: the GST UQC (Unit Quantity Code, e.g. "GMS", "PCS") a line under this HSN defaults to
  // when the transaction itself doesn't specify one. Validated against shared/gstUqc.ts's official
  // list at write time — never free text. A TRIVO business default, not a statutory mandate: e.g.
  // the seeded 7113 row defaults to GMS as this business's own convention, not because 7113 is
  // legally required to be sold by weight (see the migration's own comment). Nullable — an HSN row
  // with no default simply leaves a line's uqc unresolved unless the transaction sets one itself.
  defaultUqc  String?
  createdAt   DateTime @default(now())
  // Phase C (GST master services): distinguishes a goods code (HSN) from a services code (SAC) in
  // the SAME table, per the "reuse, don't create unnecessary GST tables" instruction for this
  // phase — this app is jewellery-goods-only today, so every existing/seeded row is 'HSN'. No 'SAC'
  // row is seeded: there is no authoritative SAC/rate source in this app (no service line is sold),
  // and shared/hsnSac.ts's searchSAC()/getSAC() are deliberately built to just return no rows until
  // real data exists, rather than fabricate any. This table is read-only to the API (db-secure.sql
  // grants trivo_runtime SELECT only), so a SAC row — like an HSN row — can only ever be added via
  // a migration, never through a request.
  codeType    String   @default("HSN")

  invoiceItems        InvoiceItem[]
  poItems             PoItem[]
  creditNoteItems     CreditNoteItem[]
  debitNoteItems      DebitNoteItem[]
  salesDebitNoteItems SalesDebitNoteItem[]
  selfInvoices        SelfInvoice[]

  @@index([codeType])
  @@map("hsn_codes")
}

// A saved thermal-label layout for the TSC TTP-244 Pro (TSPL). `layout` holds the element list
// (bound-field/literal text, barcode, QR, box/line) in mm coordinates — converted to 203dpi dots
// only at generation time (tsplGenerator.ts), so the same row also drives the visual designer's
// on-screen canvas. One row can carry a `front` and `back` wing for a two-wing paper tag; a
// single-wing template just uses `front`.
model TagTemplate {
  id          String   @id @default(cuid())
  // Direct — Phase 2. isDefault is scoped per company at the service layer (setting one
  // default unsets any other default WITHIN THE SAME company only).
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  isDefault   Boolean  @default(false)
  widthMm     Decimal  @db.Decimal(6, 2)
  heightMm    Decimal  @db.Decimal(6, 2)
  gapMm       Decimal  @default(2.0) @db.Decimal(6, 2)
  layout      Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@map("tag_templates")
}

// A saved, immutable price quote worked up for a specific JewelryTag — read-only breakdown of its
// materials, editable rates/making-charge/VA to work up a customer quote. Deliberately a snapshot,
// not a live view: saving one never writes back to JewelryTag/JewelryTagMaterial (same cost-price
// immutability principle CLAUDE.md already applies to JewelryTag.costPrice), and every save creates
// a new row instead of overwriting the last one, giving a natural history of quotes for a tag.
// companyId direct — Phase 3. A saved price quote against a company-owned JewelryTag — live,
// operational, money-related data.
model TagEstimate {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  tagId            String
  tag              JewelryTag        @relation(fields: [tagId, companyId], references: [id, companyId])
  estimateNumber   String
  items            TagEstimateItem[]
  // Making-charge (flat ₹/gram labour rate) + VA/wastage (% of metal value) — same two-sided
  // cost/sale shape as NewTagPage.tsx's MC & VA tab, applied once against total metal weight/value
  // rather than per material line (see estimation.service.ts for the exact formula).
  costMcRate       Decimal?          @db.Decimal(12, 4)
  costVaPercent    Decimal?          @db.Decimal(5, 2)
  saleMcRate       Decimal?          @db.Decimal(12, 4)
  saleVaPercent    Decimal?          @db.Decimal(5, 2)
  totalCostAmount  Decimal           @db.Decimal(12, 2)
  totalSaleAmount  Decimal           @db.Decimal(12, 2)
  // Indicative GST on the estimate — snapshotted at save time (same "a later rate change must
  // never silently reprice a past record" principle as InvoiceItem.taxRate/PriceMaster), not
  // read live from HsnCode. Matches the flat 3% jewellery rate already hardcoded for INR sales
  // elsewhere (NewSalePage.tsx, DEFAULT_HSN_CODE); non-INR estimates get 0, same convention.
  taxRate          Decimal           @default(0.03) @db.Decimal(5, 4)
  gstAmount        Decimal           @db.Decimal(12, 2)
  netPayableAmount Decimal           @db.Decimal(12, 2)
  currency         String            @default("INR")
  validUntil       DateTime?
  notes            String?
  createdById      String?
  createdBy        User?             @relation("EstimateCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime          @default(now())

  // Hand-off to the billing counter. OPEN (just a quote) -> SENT (the estimator sent it to billing; it now
  // shows up in the billing screen's estimate search) -> INVOICED (billed; invoiceId says which invoice —
  // one estimate can only be billed once). The customer name/phone are optional and exist only so the biller
  // can find "Ramesh's estimate" by name.
  status          String        @default("OPEN")
  sentToBillingAt DateTime?
  sentById        String?
  customerName    String?
  customerPhone   String?
  // The rest of the customer's details, taken when the estimate is sent to billing so the biller does not
  // have to ask again (billing finds-or-creates the Client from these). Name, phone and the sales employee are
  // required at that hand-off; DOB / address / PAN are optional.
  customerDob     DateTime?     @db.Date
  customerAddress String?
  customerPan     String?
  // The staff member showing / attending this customer (a User id, same as SalesInvoice.salesPersonId).
  salesPersonId   String?
  salesPerson     User?         @relation("EstimateSalesPerson", fields: [salesPersonId], references: [id])
  invoice         SalesInvoice? @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Restrict)
  invoiceId       String?

  @@unique([companyId, estimateNumber])
  // composite-FK target: lets the database refuse a child that points at another company's TagEstimate
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId])
  @@index([tagId])
  @@map("tag_estimates")
}

// One material line snapshotted onto a TagEstimate at save time — same field shape as
// JewelryTagMaterial's own rate/amount columns, but copied, not referenced, so a later edit to the
// tag's real materials (or the master rate cards) never reprices a past quote.
model TagEstimateItem {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  estimateId   String
  estimate     TagEstimate @relation(fields: [estimateId, companyId], references: [id, companyId], onDelete: Cascade)
  code         String
  materialType String
  name         String?
  weight       Decimal     @db.Decimal(10, 4)
  unit         String      @default("GM")
  costRate     Decimal?    @db.Decimal(12, 4)
  costAmount   Decimal?    @db.Decimal(12, 2)
  saleRate     Decimal?    @db.Decimal(12, 4)
  saleAmount   Decimal?    @db.Decimal(12, 2)

  @@index([companyId])
  @@map("tag_estimate_items")
}

// A saved print layout for a customer-facing estimate document (paper size configurable per
// template, not fixed to A4 — see widthMm/heightMm below), designed via a drag-and-drop
// canvas — same shape/precedent as TagTemplate (thermal label layout) but for the Estimation
// module's printout, which prints from `estimation.router.ts`, not tagging. `layout` holds a flat
// element list (bound-field/literal text, box/line) in mm coordinates plus one repeating
// "materialsTable" element whose row count follows the estimate's own item count — never a fixed
// number of rows, since a piece's material list varies. Sale-side data only: matches the rest of
// the Estimation module's "no cost data, ever" contract.
// companyId direct — Phase 3. Same treatment as TagTemplate (thermal label layout) — each
// company customizes its own estimate print layout.
model EstimateTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  isDefault   Boolean  @default(false)
  // Configurable, not fixed to A4 — the real printer this prints to may be a narrow continuous-
  // roll receipt/thermal printer (e.g. an Epson POS unit), not a sheet-fed A4 printer. heightMm is
  // still stored (the designer canvas needs a bounded height to lay out against, and it seeds the
  // print CSS's min-height), but content is free to run longer than it on an actual roll.
  widthMm     Decimal  @db.Decimal(6, 2)
  heightMm    Decimal  @db.Decimal(6, 2)
  layout      Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@map("estimate_templates")
}

// GST state-code master. Client.state / Branch.state / Supplier.state are free text (customer-
// entered state names) — this table lets sales code resolve that free text to the 2-digit GST
// state code needed to compare against COMPANY_STATE_CODE for CGST/SGST vs IGST (see B2).
model StateMaster {
  id       String   @id @default(cuid())
  code     String   @unique
  name     String   @unique
  aliases  String[] @default([])
  isActive Boolean  @default(true)

  @@map("state_master")
}

// How a piece is held — e.g. "Ready Stock", "Approval Stock", "Karigar Stock". Its `code` is
// meant to be short (a single letter is the common case, e.g. "R"/"A"/"K") since it becomes the
// first segment of the tag number (see NumberGen.tag in shared/numbering.ts): a tag number is
// StockType.code + ProductCategory.code + a 5-digit sequence scoped to that exact combination —
// e.g. "RRNG00001" for the first Ready-stock Ring.
model StockType {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  jewelryTags JewelryTag[]

  @@unique([companyId, code])
  // composite-FK target: lets the database refuse a child that points at another company's StockType
  @@unique([id, companyId])
  @@index([companyId])
  @@map("stock_types")
}

model StoneType {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  // Base gem identity only — e.g. one "Diamond" row, one "Ruby" row. Grading attributes
  // (shape/color/clarity/cut/quality) live on StoneGrade instead: a single stone type is
  // reused across every shape/clarity/cut combination rather than needing a separate row
  // per combination (Round-VVS-EF, Baguette-VVS-EF, ... would otherwise all need their own
  // StoneType). 'DIAMOND' vs 'STONE' (colored stone) still lives here since it's intrinsic
  // to the gem itself, not a per-grade attribute.
  itemType    String   @default("STONE")
  // Default measurement unit for this gem — carats for stone/diamond pieces (the common case),
  // grams for anything bought/tracked by weight instead (e.g. a bulk colour-stone lot). Mirrors
  // MaterialCode.unit's GM/CT/PC pattern; tagging reads this to set a picked stone row's unit
  // instead of always hardcoding CT.
  unit        String   @default("CT")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  stoneGrades       StoneGrade[]
  vendorRates       VendorComponentRate[]
  poComponents      PoItemComponent[]
  grnComponentRates GrnItemComponentRate[]

  @@unique([companyId, code])
  // composite-FK target: lets the database refuse a child that points at another company's StoneType
  @@unique([id, companyId])
  @@index([companyId])
  @@map("stone_types")
}

// A specific, reusable shape/color/clarity/cut (diamond) or quality (colored stone)
// combination for a StoneType — defined once (e.g. "Diamond — Round D VVS1 Excellent"),
// then referenced by any number of PriceMaster rows over time (repricing the same
// combination) and by JewelryTagMaterial (valuing a purchased stone against it). This is
// the reuse layer: Price Master only ever picks a Grade and sets a price, it never re-enters
// classification.
model StoneGrade {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  stoneTypeId String
  stoneType   StoneType @relation(fields: [stoneTypeId, companyId], references: [id, companyId])
  shape       String?
  color       String?
  clarity     String?
  cut         String?
  quality     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  priceMasters      PriceMaster[]
  tagMaterials      JewelryTagMaterial[]
  vendorRates       VendorComponentRate[]
  poComponents      PoItemComponent[]
  grnComponentRates GrnItemComponentRate[]

  // composite-FK target: lets the database refuse a child that points at another company's StoneGrade
  @@unique([id, companyId])
  @@index([stoneTypeId])
  @@index([companyId])
  @@map("stone_grades")
}

// companyId direct — Phase 3. A stone rate card is a company's own pricing policy (like
// MakingCharge), not a universal market constant — two companies legitimately price the same
// StoneGrade differently.
model PriceMaster {
  id            String     @id @default(cuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  itemType      String
  stoneGradeId  String
  stoneGrade    StoneGrade @relation(fields: [stoneGradeId, companyId], references: [id, companyId])
  // Snapshot of the Grade's classification at write time — same "don't let a later master
  // edit silently reprice/reclassify history" reasoning as the HSN taxRate snapshot on
  // InvoiceItem.
  shape         String?
  color         String?
  clarity       String?
  cut           String?
  weightFrom    Decimal?   @db.Decimal(10, 4)
  weightTo      Decimal?   @db.Decimal(10, 4)
  quality       String?
  pricePerCarat Decimal    @db.Decimal(12, 4)
  priceUnit     String     @default("PER_CARAT")
  effectiveDate DateTime   @default(now())
  notes         String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([companyId])
  @@index([itemType, stoneGradeId])
  @@map("price_masters")
}

model JewelryTagMaterial {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  tagId          String
  tag            JewelryTag    @relation(fields: [tagId, companyId], references: [id, companyId], onDelete: Cascade)
  materialCodeId String?
  materialCode   MaterialCode? @relation(fields: [materialCodeId, companyId], references: [id, companyId], onDelete: Restrict)
  // Bridges a stone row to the PriceMaster rate card (C4) without disturbing materialCode, which
  // stays the generic material catalogue used elsewhere (incl. dormant manufacturing BOM). Only
  // meaningful for a non-METAL row; additive/nullable so nothing existing is affected. Points at
  // a specific Grade (shape/color/clarity/cut or quality), not the raw StoneType, so valuation
  // by weight matches the exact combination rather than an arbitrary grade of that gem.
  stoneGradeId   String?
  stoneGrade     StoneGrade?   @relation(fields: [stoneGradeId, companyId], references: [id, companyId], onDelete: Restrict)
  code           String
  materialType   String
  size           String?
  pieces         Int?
  weight         Decimal       @db.Decimal(10, 4)
  unit           String        @default("GM")
  costRate       Decimal?      @db.Decimal(12, 4)
  costAmount     Decimal?      @db.Decimal(12, 2)
  saleRate       Decimal?      @db.Decimal(12, 4)
  saleAmount     Decimal?      @db.Decimal(12, 2)

  @@index([companyId])
  @@map("jewelry_tag_materials")
}

// companyId direct — Phase 3. A company's own making-charge/VA% pricing policy, not universal
// reference data.
model MakingCharge {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  materialCodeId     String?
  materialCode       MaterialCode?    @relation(fields: [materialCodeId, companyId], references: [id, companyId], onDelete: Restrict)
  // Karat/purity match dimension (KaratMaster.code convention, e.g. "18K"/"22K") — separate from
  // materialCodeId, which stays the generic-material flat-rate lookup (non-metal rows on the
  // Materials tab, e.g. clasps/findings). A METAL row's karat comes from its MaterialCode's own
  // `karat` field (see MaterialCode.karat below); this column is what a making-charge row itself
  // is pinned to, e.g. "22K gold necklaces carry 18% VA, 18K carries 22%". Null = any karat.
  karat              String?
  categoryId         String?
  category           ProductCategory? @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)
  makeType           String?
  saleWastagePercent Decimal          @default(0) @db.Decimal(5, 2)
  makingCharge       Decimal          @default(0) @db.Decimal(12, 4)
  makingChargeType   String           @default("PER_GRAM")
  effectiveDate      DateTime         @default(now())
  notes              String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([companyId])
  @@index([isActive])
  @@map("making_charges")
}

model SalesInvoice {
  id             String    @id @default(cuid())
  // Direct, never inferred from clientId or from line items (see the multi-tenant blueprint's
  // §7 finding: an invoice header previously had no branch at all, and company must not be
  // inferred through a possibly-shared Client row). Stamped from the authenticated tenant
  // context at creation; branchId is a required business field validated against the caller's
  // branch access — see createInvoice() in sales.service.ts.
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  branchId       String
  branch         Branch    @relation(fields: [branchId, companyId], references: [id, companyId])
  invoiceNumber  String
  client         Client    @relation(fields: [clientId, companyId], references: [id, companyId])
  clientId       String
  salesPerson    User?     @relation(fields: [salesPersonId], references: [id])
  salesPersonId  String?
  terms          String?
  invoiceDate    DateTime
  dueDate        DateTime?
  invoiceType    String
  currency       String    @default("INR")
  exchangeRate   Decimal   @default(1) @db.Decimal(10, 4)
  subtotal       Decimal   @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  otherCharges   Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(12, 2)
  // Adjustment to the nearest rupee (or whatever the biller keyed): totalAmount already includes it, so
  // subtotal + otherCharges - discountAmount + taxAmount + roundOff = totalAmount. Positive = customer pays more.
  roundOff       Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal   @db.Decimal(12, 2)
  paidAmount     Decimal   @default(0) @db.Decimal(12, 2)
  balanceDue     Decimal   @db.Decimal(12, 2)
  status         String    @default("DRAFT")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // J3: Void — a whole-invoice reversal (never a hard delete, see CLAUDE.md §13). status is set to
  // 'VOID' (free-text, no migration needed for that value itself); these three columns are the
  // audit-facing record of who/when/why. All nullable — every existing row defaults to null.
  voidedAt       DateTime?
  voidedById     String?
  voidedBy       User?     @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  voidReason     String?

  items           InvoiceItem[]
  taxDetails      TaxInvoice?
  // Estimates that were billed on this invoice (TagEstimate.invoiceId).
  billedEstimates TagEstimate[]
  exportDocs      ExportDocument[]
  payments        InvoicePayment[]
  returns         SalesReturn[]
  repairJob       RepairJob?
  creditNotes     CreditNote[]
  salesDebitNotes SalesDebitNote[]
  eInvoiceRecords EInvoiceRecord[]

  @@unique([companyId, invoiceNumber])
  // composite-FK target: lets the database refuse a child that points at another company's SalesInvoice
  @@unique([id, companyId])
  @@index([companyId, branchId])
  @@index([status, invoiceDate])
  // Phase 4 Part N: reports.router.ts's dashboard "recent invoices" query filters by
  // companyId+createdAt and sorts by createdAt — neither existing index carries createdAt.
  @@index([companyId, createdAt])
  @@map("sales_invoices")
}

model InvoiceItem {
  id             String       @id @default(cuid())
  // Denormalized from the parent SalesInvoice at create time (never independently supplied) —
  // needed so InvoiceItem can carry its own RLS policy without a correlated subquery up to
  // sales_invoices on every row. See the multi-tenant blueprint's RLS-denormalization rule.
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  invoice        SalesInvoice @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Cascade)
  invoiceId      String
  productCode    String
  description    String
  huid           String?
  karat          String?
  quantity       Int
  grossWeight    Decimal      @db.Decimal(10, 4)
  netGoldWeight  Decimal      @db.Decimal(10, 4)
  stoneWeight    Decimal      @default(0) @db.Decimal(10, 4)
  rateType       String
  goldRate       Decimal      @db.Decimal(12, 4)
  makingCharge   Decimal      @db.Decimal(12, 2)
  // Value-addition % (a.k.a. "VA" — trade jargon already used informally in NewTagPage.tsx for
  // the MakingCharge master's wastagePercent). Same formula: effective making charge is marked
  // up by this percent, matching the one precedent for this concept already in the codebase.
  wastagePercent Decimal      @default(0) @db.Decimal(5, 2)
  stoneValue     Decimal      @default(0) @db.Decimal(12, 2)
  unitPrice      Decimal      @db.Decimal(12, 2)
  totalPrice     Decimal      @db.Decimal(12, 2)

  // GST rate looked up from HsnCode at sale time and copied onto the line (like costPrice on
  // JewelryTag) — a later change to the HSN master must not silently reprice past invoices.
  hsnCode            HsnCode? @relation(fields: [hsnCodeId], references: [id])
  hsnCodeId          String?
  taxRate            Decimal  @db.Decimal(5, 4)
  // G1 Part D: free-text unit of measure (e.g. "PCS", "GRM") — an e-invoice line item concept
  // this codebase had no field for at all. Optional: existing/simple lines need not set it.
  // Deliberately left as-is (unused/null) by G2g-3a below rather than repurposed — see uqc's
  // comment for why.
  uom                String?
  // G2g-3a: the statutory GST UQC snapshot for GSTR-1 Table 12 (HSN + UQC + Quantity + Rate).
  // Added alongside `uom` rather than renaming/reusing it: `uom` is read by the existing tax
  // invoice/credit note/debit note print-template column whitelists (taxInvoiceBoundFields.ts
  // and siblings) by that exact column name, and repurposing it would silently blank an existing
  // template's "uom" column for every past invoice. Validated against shared/gstUqc.ts's official
  // UQC list at write time (never free text); resolved once at invoice-creation time from an
  // explicit line value or the line's HsnCode.defaultUqc, then never re-derived — a later change
  // to the HSN master's default must not silently reprice/reclassify a past invoice line, same
  // rule as taxRate/hsnCodeId above. Null when neither the line nor its HSN supplied one.
  uqc                String?
  // G1 Part D: this line's own slice of the invoice-level discount/tax, snapshotted at sale time
  // (like taxRate above) so a later change to anything upstream never reprices a past invoice
  // line. taxableValue = totalPrice, net of this line's proportional share of the invoice
  // discount; lineDiscountAmount is that share; cgst/sgst/igstAmount are taxableValue * taxRate,
  // split same-state/inter-state exactly like the invoice-level TaxInvoice.cgst/sgst/igst;
  // lineTotalTax is their sum. All default 0 so an existing row (pre-G1) reads as "not computed."
  taxableValue       Decimal  @default(0) @db.Decimal(12, 2)
  lineDiscountAmount Decimal  @default(0) @db.Decimal(12, 2)
  cgstAmount         Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount         Decimal  @default(0) @db.Decimal(12, 2)
  igstAmount         Decimal  @default(0) @db.Decimal(12, 2)
  lineTotalTax       Decimal  @default(0) @db.Decimal(12, 2)

  // Optional link to real inventory (JewelryTag). Nullable: free-text lines (making-charge-only
  // adjustments, gift-wrap fees, historical entries) still coexist during the transition — tagged
  // and untagged lines are both legal. Not unique (D1): a returned tag flips back to IN_STOCK and
  // can be sold again, appearing on a second InvoiceItem later — the IN_STOCK gate in
  // createInvoice, not a DB-level uniqueness, is what prevents double-selling a currently-SOLD tag.
  tagId String?
  tag   JewelryTag? @relation(fields: [tagId, companyId], references: [id, companyId], onDelete: Restrict)

  // A loose-metal line sold out of the Metal Vault (no tag): netGoldWeight x quantity grams of `karat` leave the vault
  // when the bill is issued (MetalStockMovement MATERIAL_SALE) and come back on a return/void. Never set with tagId.
  materialSale Boolean @default(false)

  // This bill's own copy of the piece's material rows + MC/VA rates, as charged ({ rows, mcRate, vaPercent } —
  // shared/materialBreakdown.ts). Edited per sale; never written back to the JewelryTag. Null for a plain line.
  materialBreakdown Json?

  // The employee credited with THIS line (a User id; membership of the invoice's company is checked in code — User is a
  // global identity, so this FK cannot be composite). Null = the line inherits SalesInvoice.salesPersonId for reporting.
  salesPersonId String?
  salesPerson   User?   @relation("InvoiceItemSalesPerson", fields: [salesPersonId], references: [id], onDelete: Restrict)

  // Category snapshot for the per-invoice category summary. Reuses the same ProductCategory
  // master JewelryTag already carries — tagged lines inherit the tag's category; free-text lines
  // may set one explicitly. Snapshotted like hsnCodeId so a later tag/category edit doesn't
  // silently reclassify a past invoice line.
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)

  returnItems         SalesReturnItem[]
  creditNoteItems     CreditNoteItem[]
  salesDebitNoteItems SalesDebitNoteItem[]

  // composite-FK target: lets the database refuse a child that points at another company's InvoiceItem
  @@unique([id, companyId])
  @@index([tagId])
  @@index([companyId])
  @@index([companyId, salesPersonId])
  @@map("invoice_items")
}

model InvoicePayment {
  id             String        @id @default(cuid())
  // Direct — Phase 2. Denormalized from clientId (always present, unlike invoiceId).
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  paymentNumber  String
  // Nullable (F2): a standalone/on-account payment isn't against any one invoice yet. clientId is
  // stored directly on every row (not just resolved through invoice.clientId) so both kinds query
  // uniformly for a client statement (F4) without a conditional join.
  invoice        SalesInvoice? @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Restrict)
  invoiceId      String?
  client         Client        @relation(fields: [clientId, companyId], references: [id, companyId])
  clientId       String
  paymentDate    DateTime
  amount         Decimal       @db.Decimal(12, 2)
  mode           String
  referenceNo    String?
  forexRate      Decimal?      @db.Decimal(10, 4)
  forexGainLoss  Decimal?      @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  // J3 Decision 1 (Option A — flag the original row, never edit/delete it): a reversed payment is
  // never money-real again. Every place that sums InvoicePayment as a receipt must add
  // `reversedAt: null` to its filter (see getClientLedger/getDayBook in finance.service.ts).
  reversedAt     DateTime?
  reversedById   String?
  reversedBy     User?         @relation("PaymentReversedBy", fields: [reversedById], references: [id])
  reversalReason String?

  @@unique([companyId, paymentNumber])
  @@index([companyId])
  @@map("invoice_payments")
}

// A completed retail sale reversed (D1) — the customer brought a piece back. Deliberately a new,
// separate record referencing the original invoice rather than an edit to it: SalesInvoice/
// InvoiceItem stay exactly as originally issued (see CLAUDE.md's "never rewrite history" rule).
model SalesReturn {
  id           String       @id @default(cuid())
  // Direct — Phase 2.
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  returnNumber String
  invoice      SalesInvoice @relation(fields: [invoiceId, companyId], references: [id, companyId])
  invoiceId    String
  client       Client       @relation(fields: [clientId, companyId], references: [id, companyId])
  clientId     String
  returnDate   DateTime     @default(now())
  reason       String?
  notes        String?
  totalAmount  Decimal      @db.Decimal(12, 2)
  createdAt    DateTime     @default(now())

  items      SalesReturnItem[]
  creditNote CreditNote?

  @@unique([companyId, returnNumber])
  // composite-FK target: lets the database refuse a child that points at another company's SalesReturn
  @@unique([id, companyId])
  @@index([companyId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  return        SalesReturn @relation(fields: [returnId, companyId], references: [id, companyId], onDelete: Cascade)
  returnId      String
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId, companyId], references: [id, companyId])
  invoiceItemId String
  // Set for a tagged line; null for a material (vault) line, which carries returnedWeight instead.
  tag           JewelryTag? @relation(fields: [tagId, companyId], references: [id, companyId], onDelete: Restrict)
  tagId         String?
  // Grams of a material line given back (null on a tagged line). Summed per invoice line it can never exceed what was sold.
  returnedWeight Decimal?   @db.Decimal(12, 4)
  amount        Decimal     @db.Decimal(12, 2)

  repairCase    RepairCase?

  // composite-FK target for RepairCase
  @@unique([id, companyId])
  @@index([companyId])
  @@index([invoiceItemId])
  @@map("sales_return_items")
}

// G2a: GST credit note against a real sales invoice (schema/RLS foundation only — no
// creation/cancellation/GST-calculation/journal service logic yet; that is a later G2 step, see
// CLAUDE.md's G2a entry). Deliberately its own document, never an edit to SalesInvoice/InvoiceItem
// — same "never rewrite history" rule as SalesReturn. salesReturnId is optional: a credit note may
// originate from a SalesReturn (goods physically came back) or stand alone (a pure price/value
// adjustment with no return) — hence @@unique([salesReturnId, companyId]) below, not a plain index:
// at most one credit note per return (SalesReturn.creditNote is a singular back-relation).
// sellerRegistrationId mirrors TaxInvoice's own field exactly: a plain traceability String with no
// enforced relation (see TaxInvoice's comment for why) — the seller/buyer snapshot columns below it
// are what make the note immutable, not that FK.
model CreditNote {
  id                    String       @id @default(cuid())
  companyId             String
  company               Company      @relation(fields: [companyId], references: [id])
  creditNoteNumber      String
  financialYear         Int
  creditNoteDate        DateTime     @default(now())
  invoice               SalesInvoice @relation(fields: [invoiceId, companyId], references: [id, companyId])
  invoiceId             String
  originalInvoiceNumber String
  originalInvoiceDate   DateTime
  salesReturn           SalesReturn? @relation(fields: [salesReturnId, companyId], references: [id, companyId])
  salesReturnId         String?
  client                Client       @relation(fields: [clientId, companyId], references: [id, companyId])
  clientId              String
  reasonCode            String
  reasonNotes           String?

  // Seller snapshot (mirrors TaxInvoice's Part E snapshot fields exactly).
  gstin                String
  placeOfSupply        String
  sellerRegistrationId String?
  sellerLegalName      String?
  sellerTradeName      String?
  sellerStateCode      String?
  sellerAddress        String?
  sellerCity           String?
  sellerDistrict       String?
  sellerPincode        String?
  sellerCountry        String?

  // Buyer snapshot (mirrors TaxInvoice's Part E snapshot fields exactly).
  buyerName      String?
  buyerGstin     String?
  buyerPan       String?
  buyerAddress   String?
  buyerCity      String?
  buyerState     String?
  buyerStateCode String?
  buyerPincode   String?
  buyerCountry   String?

  taxableAmount Decimal @db.Decimal(12, 2)
  cgst          Decimal @default(0) @db.Decimal(12, 2)
  sgst          Decimal @default(0) @db.Decimal(12, 2)
  igst          Decimal @default(0) @db.Decimal(12, 2)
  totalTax      Decimal @db.Decimal(12, 2)
  totalAmount   Decimal @db.Decimal(12, 2)

  status        String    @default("ISSUED")
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("CreditNoteCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?

  // Accounting pointer — plain FK: JournalEntry has no @@unique([id, companyId]) composite target
  // (see its model comment), same reasoning every other JournalEntry-referencing FK in this schema
  // already follows.
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  // Dormant future e-invoice fields (mirrors TaxInvoice; unused until GST e-invoicing for credit
  // notes is built).
  irn        String?
  ackNumber  String?
  ackDate    DateTime?
  qrCodeData String?

  createdById String?
  createdBy   User?    @relation("CreditNoteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  items CreditNoteItem[]

  // G2g-3g-0.1: scoped by sellerRegistrationId, not company-wide — the generating sequence
  // (numberSequence.ts, key `CN:${sellerRegistrationId ?? 'LEGACY'}`) is already partitioned per
  // GST registration (Rule 46(b): the credit note number is a per-registration statutory unit),
  // so two registrations both legitimately issue their own "CN-2026-000001". A plain
  // (companyId, creditNoteNumber) constraint rejected the second registration's first note as a
  // duplicate of the first's. Explicitly named (unhashed default would exceed Postgres's 63-byte
  // identifier limit at 64 bytes and get silently truncated).
  //
  // NULL handling: Postgres never treats two NULLs as equal in a unique index, so this constraint
  // alone does NOT stop two rows with sellerRegistrationId = NULL (a company with no
  // CompanyGstRegistration row — the 'LEGACY' sequence key) from sharing a creditNoteNumber. The
  // sequence itself already prevents that in practice (every LEGACY-registration note draws from
  // the same atomic `CN:LEGACY` counter), but the migration adds a second, partial unique index —
  // `credit_notes_legacy_number_key` on (companyId, creditNoteNumber) WHERE sellerRegistrationId
  // IS NULL — as a real database-level backstop for that group, since Prisma's schema DSL cannot
  // express a partial index itself (see the migration's raw SQL).
  @@unique([companyId, sellerRegistrationId, creditNoteNumber], map: "credit_notes_company_registration_number_key")
  // composite-FK target: lets the database refuse a child that points at another company's CreditNote
  @@unique([id, companyId])
  // enforces at most one credit note per sales return (SalesReturn.creditNote is a to-one back-relation)
  @@unique([salesReturnId, companyId])
  @@index([companyId])
  @@index([invoiceId])
  @@map("credit_notes")
}

model CreditNoteItem {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  creditNote    CreditNote   @relation(fields: [creditNoteId, companyId], references: [id, companyId], onDelete: Cascade)
  creditNoteId  String
  // Optional: which original invoice line this credits, when it traces to one (InvoiceItem.creditNoteItems
  // is plural — a line may be credited more than once across separate partial credit notes).
  invoiceItem   InvoiceItem? @relation(fields: [invoiceItemId, companyId], references: [id, companyId])
  invoiceItemId String?
  description   String

  // Snapshot like InvoiceItem.hsnCodeId/taxRate — a later HSN-rate change must not reprice a past note.
  hsnCode   HsnCode? @relation(fields: [hsnCodeId], references: [id])
  hsnCodeId String?
  taxRate   Decimal  @db.Decimal(5, 4)
  uom       String?
  // G2g-3a: statutory quantity + UQC snapshot, same rationale as InvoiceItem.uqc (added
  // alongside `uom`, never reusing it — see that field's comment). Decimal, not Int: a PCS credit
  // is a whole number (1, 2, 5) but a GMS credit can be fractional (11.2500), same precision as
  // grossWeight/netWeight below. Nullable, and deliberately left null rather than fabricated when
  // the calling path (see creditNote.service.ts) cannot establish a real physical/statutory
  // quantity for the line — a value-only price adjustment has no physical quantity to report.
  quantity  Decimal? @db.Decimal(10, 4)
  uqc       String?

  taxableValue Decimal @default(0) @db.Decimal(12, 2)
  cgstAmount   Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount   Decimal @default(0) @db.Decimal(12, 2)
  igstAmount   Decimal @default(0) @db.Decimal(12, 2)
  lineTotalTax Decimal @default(0) @db.Decimal(12, 2)
  totalValue   Decimal @default(0) @db.Decimal(12, 2)

  grossWeight Decimal? @db.Decimal(10, 4)
  netWeight   Decimal? @db.Decimal(10, 4)
  stoneWeight Decimal? @db.Decimal(10, 4)
  karat       String?

  @@index([companyId])
  @@index([creditNoteId])
  @@index([invoiceItemId])
  @@map("credit_note_items")
}

// G2g-4b — Sales (outward) Debit Note. A SEPARATE domain from the procurement-side DebitNote
// above — that model stays purchase-side only (a supplier owes TRIVO less / TRIVO billed a
// supplier). This one is the sell-side mirror of CreditNote: it INCREASES what a customer owes
// against an existing SalesInvoice (an under-billed price/quantity/charge corrected upward after
// issuance), never a decrease. One SalesDebitNote -> one original SalesInvoice is this phase's
// own implementation-scope decision (not a statutory 1:1 requirement) — schema/service still
// avoid anything that would make a future 1:N extension impossible (no multi-invoice join table
// is introduced here).
//
// branchId is carried directly (unlike CreditNote, which has none and inherits branch through its
// invoice) — G2g-4b.1's approved design calls for branch-level authorization/reporting on this
// document without a join back to SalesInvoice on every check. Always the ORIGINAL invoice's own
// branchId at creation (salesDebitNote.service.ts), never independently chosen.
//
// sellerRegistrationId mirrors TaxInvoice/CreditNote's own field exactly: a plain traceability
// String with no enforced relation (see TaxInvoice's comment for why) — the seller/buyer snapshot
// columns below it are what make the note immutable, not that FK.
model SalesDebitNote {
  id                    String       @id @default(cuid())
  companyId             String
  company               Company      @relation(fields: [companyId], references: [id])
  branchId              String
  branch                Branch       @relation(fields: [branchId, companyId], references: [id, companyId])
  debitNoteNumber       String
  financialYear         Int
  debitNoteDate         DateTime     @default(now())
  invoice               SalesInvoice @relation(fields: [invoiceId, companyId], references: [id, companyId])
  invoiceId             String
  originalInvoiceNumber String
  originalInvoiceDate   DateTime
  client                Client       @relation(fields: [clientId, companyId], references: [id, companyId])
  clientId              String
  reasonCode            String
  reasonNotes           String?

  // Seller snapshot (mirrors TaxInvoice/CreditNote's Part E snapshot fields exactly).
  gstin                String
  placeOfSupply        String
  sellerRegistrationId String?
  sellerLegalName      String?
  sellerTradeName      String?
  sellerStateCode      String?
  sellerAddress        String?
  sellerCity           String?
  sellerDistrict       String?
  sellerPincode        String?
  sellerCountry        String?

  // Buyer snapshot (mirrors TaxInvoice/CreditNote's Part E snapshot fields exactly).
  buyerName      String?
  buyerGstin     String?
  buyerPan       String?
  buyerAddress   String?
  buyerCity      String?
  buyerState     String?
  buyerStateCode String?
  buyerPincode   String?
  buyerCountry   String?

  taxableAmount Decimal @db.Decimal(12, 2)
  cgst          Decimal @default(0) @db.Decimal(12, 2)
  sgst          Decimal @default(0) @db.Decimal(12, 2)
  igst          Decimal @default(0) @db.Decimal(12, 2)
  // Always 0 in this phase — no cess-rate master exists for this jewelry-only business (same
  // posture as TaxInvoice.cess on every existing invoice). Column present for schema completeness
  // per the approved G2g-4b.1 design, never computed/fabricated.
  cess          Decimal @default(0) @db.Decimal(12, 2)
  totalTax      Decimal @db.Decimal(12, 2)
  totalAmount   Decimal @db.Decimal(12, 2)

  status        String    @default("ISSUED")
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("SalesDebitNoteCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?

  // Accounting pointer — plain FK: JournalEntry has no @@unique([id, companyId]) composite target,
  // same reasoning every other JournalEntry-referencing FK in this schema already follows.
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  // Dormant future e-invoice fields (mirrors TaxInvoice/CreditNote; unused until GST e-invoicing
  // for sales debit notes is built — document type code for that future phase is "DBN", not
  // persisted anywhere since nothing in THIS phase ever sets these).
  isEInvoice Boolean   @default(false)
  irn        String?
  ackNumber  String?
  ackDate    DateTime?
  qrCodeData String?

  createdById String?
  createdBy   User?    @relation("SalesDebitNoteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  items SalesDebitNoteItem[]

  // Scoped by sellerRegistrationId, not company-wide — the generating sequence
  // (numberSequence.ts, key `SDN:${sellerRegistrationId ?? 'LEGACY'}`) is already partitioned per
  // GST registration (Rule 46(b): the debit note number is a per-registration statutory unit),
  // same precedent as CreditNote.creditNoteNumber's own uniqueness constraint. Explicitly named
  // (unhashed default would exceed Postgres's 63-byte identifier limit and get silently truncated).
  //
  // NULL handling: Postgres never treats two NULLs as equal in a unique index, so this constraint
  // alone does NOT stop two rows with sellerRegistrationId = NULL (a company with no
  // CompanyGstRegistration row — the 'LEGACY' sequence key) from sharing a debitNoteNumber. The
  // sequence itself already prevents that in practice, but the migration adds a second, partial
  // unique index — `sales_debit_notes_legacy_number_key` on (companyId, debitNoteNumber) WHERE
  // sellerRegistrationId IS NULL — as a real database-level backstop, same as CreditNote's own.
  @@unique([companyId, sellerRegistrationId, debitNoteNumber], map: "sales_debit_notes_company_registration_number_key")
  // composite-FK target: lets the database refuse a child that points at another company's SalesDebitNote
  @@unique([id, companyId])
  @@index([companyId])
  @@index([invoiceId])
  @@index([branchId])
  @@map("sales_debit_notes")
}

model SalesDebitNoteItem {
  id               String         @id @default(cuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  salesDebitNote   SalesDebitNote @relation(fields: [salesDebitNoteId, companyId], references: [id, companyId], onDelete: Cascade)
  salesDebitNoteId String
  // Optional: which original invoice line this debits, when it traces to one (InvoiceItem.salesDebitNoteItems
  // is plural — a line may be debited more than once across separate partial debit notes).
  invoiceItem      InvoiceItem?   @relation(fields: [invoiceItemId, companyId], references: [id, companyId])
  invoiceItemId    String?
  description      String

  // Snapshot like InvoiceItem.hsnCodeId/taxRate — a later HSN-rate change must not reprice a past note.
  hsnCode   HsnCode? @relation(fields: [hsnCodeId], references: [id])
  hsnCodeId String?
  taxRate   Decimal  @db.Decimal(5, 4)
  uom       String?
  // Statutory quantity + UQC snapshot, same rationale/convention as CreditNoteItem.quantity/uqc.
  // Decimal, not Int: a PCS debit is a whole number but a GMS debit can be fractional. Nullable,
  // left null for a value-only line (no physical quantity to report) — see
  // salesDebitNote.service.ts's line builder.
  quantity  Decimal? @db.Decimal(10, 4)
  uqc       String?

  taxableValue Decimal @default(0) @db.Decimal(12, 2)
  cgstAmount   Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount   Decimal @default(0) @db.Decimal(12, 2)
  igstAmount   Decimal @default(0) @db.Decimal(12, 2)
  // Always 0 — see SalesDebitNote.cess's own comment; never fabricated down from a header figure.
  cessAmount   Decimal @default(0) @db.Decimal(12, 2)
  lineTotalTax Decimal @default(0) @db.Decimal(12, 2)
  totalValue   Decimal @default(0) @db.Decimal(12, 2)

  grossWeight Decimal? @db.Decimal(10, 4)
  netWeight   Decimal? @db.Decimal(10, 4)
  stoneWeight Decimal? @db.Decimal(10, 4)
  karat       String?

  @@index([companyId])
  @@index([salesDebitNoteId])
  @@index([invoiceItemId])
  @@map("sales_debit_note_items")
}

model ExportDocument {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  invoice      SalesInvoice @relation(fields: [invoiceId, companyId], references: [id, companyId])
  invoiceId    String
  documentType String
  documentData Json
  irn          String?
  ewbNumber    String?
  generatedAt  DateTime     @default(now())

  @@index([companyId])
  @@map("export_documents")
}

// ═══════════════════════════════════════════════════
// MODULE 9: INTEGRATED FINANCIAL ACCOUNTING
// ═══════════════════════════════════════════════════

// Company-owned — Phase 2. Each company gets its OWN copy of the 35-account chart, seeded from
// the fixed seedChartOfAccounts() template at company-creation time (same template/copy pattern
// as RoleTemplate -> Role, deliberately, for the exact same nullable-unique-constraint reasons —
// see the multi-tenant blueprint's Role-uniqueness correction). shared/ledgerAccounts.ts's
// LEDGER_ACCOUNT codes ('1101' etc.) now resolve within one company's own rows, never globally.
model Account {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  code      String
  name      String
  type      String
  subType   String?
  parent    Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  parentId  String?
  children  Account[] @relation("AccountHierarchy")
  balance   Decimal   @default(0) @db.Decimal(14, 2)
  currency  String    @default("INR")
  isSystem  Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  journalLines JournalLine[]

  @@unique([companyId, code])
  @@index([companyId, type])
  @@map("accounts")
}

model JournalEntry {
  id            String      @id @default(cuid())
  // Direct — no reliable single parent to inherit from (referenceType/referenceId is an
  // untyped polymorphic pointer, not a real FK) — stamped from the caller's tenant context.
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  entryNumber   String
  date          DateTime
  description   String
  referenceType String?
  referenceId   String?
  costCenter    CostCenter? @relation(fields: [costCenterId], references: [id])
  costCenterId  String?
  isPosted      Boolean     @default(false)
  postedAt      DateTime?
  totalDebit    Decimal     @db.Decimal(14, 2)
  totalCredit   Decimal     @db.Decimal(14, 2)
  createdAt     DateTime    @default(now())

  lines                       JournalLine[]
  creditNotes                 CreditNote[]
  debitNotes                  DebitNote[]
  salesDebitNotes             SalesDebitNote[]
  // G2g-7d: the liability-recognition journal (Dr RCM ITC / Cr RCM Payable) and, separately, the
  // cash-settlement journal (Dr RCM Payable / Cr Cash-or-Bank) posted when it is later paid —
  // distinct relation names since one RcmLiability can point at both.
  rcmLiabilityJournals        RcmLiability[]   @relation("RcmLiabilityJournal")
  rcmLiabilityPaymentJournals RcmLiability[]   @relation("RcmLiabilityPaymentJournal")

  @@unique([companyId, entryNumber])
  @@index([companyId, date, isPosted])
  @@index([date, isPosted])
  @@map("journal_entries")
}

model JournalLine {
  id        String       @id @default(cuid())
  // Denormalized from the parent JournalEntry.
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId   String
  account   Account      @relation(fields: [accountId], references: [id])
  accountId String
  debit     Decimal      @default(0) @db.Decimal(14, 2)
  credit    Decimal      @default(0) @db.Decimal(14, 2)
  narration String?

  @@index([companyId])
  @@map("journal_lines")
}

model CostCenter {
  id         String       @id @default(cuid())
  companyId  String
  company    Company      @relation(fields: [companyId], references: [id])
  code       String
  name       String
  department String
  parent     CostCenter?  @relation("CCHierarchy", fields: [parentId], references: [id])
  parentId   String?
  children   CostCenter[] @relation("CCHierarchy")
  isActive   Boolean      @default(true)

  journalEntries JournalEntry[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("cost_centers")
}

model TaxInvoice {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  invoice       SalesInvoice @relation(fields: [invoiceId, companyId], references: [id, companyId])
  invoiceId     String       @unique
  gstin         String
  placeOfSupply String
  reverseCharge Boolean      @default(false)
  taxableAmount Decimal      @db.Decimal(12, 2)
  cgst          Decimal      @default(0) @db.Decimal(12, 2)
  sgst          Decimal      @default(0) @db.Decimal(12, 2)
  igst          Decimal      @default(0) @db.Decimal(12, 2)
  cess          Decimal      @default(0) @db.Decimal(12, 2)
  totalTax      Decimal      @db.Decimal(12, 2)
  isEInvoice    Boolean      @default(false)
  irn           String?
  ackNumber     String?
  ackDate       DateTime?
  qrCodeData    String?
  ewbNumber     String?
  ewbValidUntil DateTime?

  // G1 Part E: the GST registration this sale was actually invoiced under (may be null for an
  // invoice created before this phase, or a company that never set one up) — kept purely for
  // traceability/reporting; the snapshot fields below, not this FK, are what makes the invoice
  // immutable (a later edit/deactivation of the registration itself must never change what an
  // already-issued invoice shows).
  sellerRegistrationId String?

  // G1 Part E — immutable SELLER snapshot, captured once at invoice-creation time from the
  // resolved CompanyGstRegistration (or, for a company with none, from the legacy Company
  // fields). Fixes the "hardcoded SEA Jewelry Pvt. Ltd." bug: printInvoice.ts now reads these
  // columns instead of a string literal, and — because they are a snapshot, not a live join —
  // a later address/name/GSTIN change never rewrites a historical invoice.
  sellerLegalName String?
  sellerTradeName String?
  sellerStateCode String?
  sellerAddress   String?
  sellerCity      String?
  sellerDistrict  String?
  sellerPincode   String?
  sellerCountry   String?

  // G1 Part E — immutable BUYER snapshot, captured once at invoice-creation time from the
  // resolved Client row. Same immutability rule: editing the Client afterward must not change
  // what a re-print of this invoice shows.
  buyerName      String?
  buyerGstin     String?
  buyerPan       String?
  buyerAddress   String?
  buyerCity      String?
  buyerState     String?
  buyerStateCode String?
  buyerPincode   String?
  buyerCountry   String?

  // the relation is one-to-one (invoiceId is @unique), so its composite-FK form needs a matching composite unique
  @@unique([invoiceId, companyId])
  @@index([companyId])
  @@map("tax_invoices")
}

model PurchaseRequisition {
  id                   String            @id @default(cuid())
  companyId            String
  company              Company           @relation(fields: [companyId], references: [id])
  prNumber             String
  department           String
  status               String            @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | CONVERTED
  notes                String?
  totalEstimatedAmount Decimal           @default(0) @db.Decimal(12, 2)
  requestedById        String
  requestedBy          User              @relation("PRRequester", fields: [requestedById], references: [id])
  approvedById         String?
  approvedBy           User?             @relation("PRApprover", fields: [approvedById], references: [id])
  approvedAt           DateTime?
  convertedPoId        String?
  items                PrItem[]
  approvalHistory      ApprovalHistory[] @relation("PRHistory")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  purchaseOrders       PurchaseOrder[]

  @@unique([companyId, prNumber])
  @@index([companyId])
  @@map("purchase_requisitions")
}

model PrItem {
  id                   String              @id @default(cuid())
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id])
  prId                 String
  pr                   PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  materialCode         String
  materialName         String
  materialType         String
  karat                String?
  quantity             Decimal             @db.Decimal(10, 4)
  weight               Decimal             @db.Decimal(10, 4)
  unit                 String
  estimatedRate        Decimal             @db.Decimal(12, 4)
  totalEstimatedAmount Decimal             @db.Decimal(12, 2)

  @@index([companyId])
  @@map("pr_items")
}

model ApprovalHistory {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  referenceType String // "PR" | "PO"
  referenceId   String // General ID for query indexing
  action        String // "SUBMITTED" | "APPROVED" | "REJECTED" | "CONVERTED"
  comments      String?
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  createdAt     DateTime @default(now())

  purchaseRequisitionId String?
  purchaseRequisition   PurchaseRequisition? @relation("PRHistory", fields: [purchaseRequisitionId], references: [id], onDelete: Cascade)
  purchaseOrderId       String?
  purchaseOrder         PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([referenceType, referenceId])
  @@map("approval_history")
}

// G8c — one e-invoice (IRN) operation record per (registration, document type, document, environment).
// The unique index IS the idempotency + concurrency gate: a second concurrent attempt cannot insert a
// second row. Status: PENDING (claimed, provider call in flight) | SUCCESS | FAILED (provider
// definitively rejected / never reached — safe to attempt again) | AMBIGUOUS (the outcome is unknown —
// timeout, 5xx, malformed reply, duplicate-at-provider — NEVER regenerated automatically; needs a
// controlled Get-IRN lookup, a later phase). Holds NO credential, token or auth header, and not the
// request payload; signedInvoice/signedQrCode are the provider's own signed artefacts (the legal
// e-invoice), which is the whole point of the row.
model EInvoiceRecord {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  gstRegistration   CompanyGstRegistration @relation(fields: [gstRegistrationId, companyId], references: [id, companyId], onDelete: Restrict)
  gstRegistrationId String

  invoice   SalesInvoice @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Restrict)
  invoiceId String

  // INV today (CRN/DBN are not built yet) — free string, same convention as the other G8 columns.
  documentType String
  provider     String
  // SANDBOX | PRODUCTION
  environment  String
  status       String @default("PENDING")

  correlationId  String
  idempotencyKey String

  irn               String?
  ackNumber         String?
  ackDate           DateTime?
  signedInvoice     String?   @db.Text
  signedQrCode      String?   @db.Text
  providerStatus    String?
  providerTimestamp DateTime?
  generatedAt       DateTime?

  errorCategory String?
  errorCode     String?
  errorMessage  String?

  attempts    Int      @default(1)
  createdById String?
  createdBy   User?    @relation("EInvoiceRecordCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, gstRegistrationId, documentType, invoiceId, environment])
  @@unique([companyId, idempotencyKey])
  @@index([companyId])
  @@index([invoiceId])
  @@map("einvoice_records")
}

// Append-only history of every change to a JewelryTag (barcode). Written ONLY by the database trigger
// tag_history_capture (migration 20261004120000) — never by application code — so nothing that changes a
// tag can skip it. `snapshot` is the whole tag row after the change; `changes` is { field: {from,to} }.
// No FK on tagId on purpose: the history outlives a deleted tag. Read-only for the app (UPDATE/DELETE revoked).
model TagHistory {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  tagId         String
  tagNumber     String
  event         String   // CREATED | BASELINE | STATUS_CHANGE | BRANCH_CHANGE | EDITED | DELETED
  branchId      String?
  status        String?
  changedFields String[] @default([])
  changes       Json?
  snapshot      Json
  actorUserId   String?
  createdAt     DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, tagId, createdAt])
  @@index([companyId, tagNumber])
  @@map("tag_history")
}

// ═══════════════════════════════════════════════════
// RETURNED-JEWELLERY INSPECTION / REPAIR / RETAGGING
// ═══════════════════════════════════════════════════
// A sold piece the customer brings back is NOT saleable again until Head Office has inspected (and if need be
// repaired) it. SalesReturn stays the *financial* record; RepairCase is the operational one — the Repair Register
// row that follows the same JewelryTag (same row, same tag number) from the return until it is back IN_STOCK,
// held for melting, or replaced by a retag. `status` mirrors JewelryTag.status while the piece is in this
// pipeline (the tag's status is what controls saleability); `currentLocation` is the separate physical-custody
// fact (BRANCH | IN_TRANSIT | HEAD_OFFICE). Weights/karat/description are snapshots at the moment of return.
model RepairCase {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  repairNumber       String
  tagId              String
  tag                JewelryTag       @relation(fields: [tagId, companyId], references: [id, companyId], onDelete: Restrict)
  // One case per returned line; null for a future customer-repair case that did not come from a sale return.
  salesReturnItemId  String?
  salesReturnItem    SalesReturnItem? @relation(fields: [salesReturnItemId, companyId], references: [id, companyId], onDelete: Restrict)
  originBranchId     String
  originBranch       Branch           @relation(fields: [originBranchId, companyId], references: [id, companyId], onDelete: Restrict)
  // RETURNED_PENDING_TRANSFER | IN_TRANSIT_TO_HO | HO_RECEIVED | REPAIR_REQUIRED | IN_REPAIR | REPAIR_COMPLETED
  // | INSPECTION_PASSED | MELT_PENDING | RETAGGED   (shared/constants.ts: REPAIR_CASE_STATUS)
  status             String           @default("RETURNED_PENDING_TRANSFER")
  currentLocation    String           @default("BRANCH")
  returnReason       String?
  description        String
  karat              String?
  grossWeight        Decimal          @db.Decimal(10, 4)
  stoneWeight        Decimal          @db.Decimal(10, 4)
  netWeight          Decimal          @db.Decimal(10, 4)
  hoReceivedById     String?
  hoReceivedAt       DateTime?
  inspectionResult   String?          // PASS | REPAIR_REQUIRED | MELT
  inspectedById      String?
  inspectedAt        DateTime?
  repairReason       String?
  assignedToId       String?
  repairEmployeeId   String?
  repairStartedAt    DateTime?
  repairCompletedAt  DateTime?
  repairDetails      String?
  repairCost         Decimal?         @db.Decimal(12, 2)
  finalInspectedById String?
  finalInspectedAt   DateTime?
  remarks            String?
  createdById        String
  updatedById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  transferItems RepairTransferItem[]
  retag         TagRetag?

  @@unique([companyId, repairNumber])
  @@unique([salesReturnItemId, companyId])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, tagId])
  @@map("repair_cases")
}

// Branch -> Head Office custody document for returned pieces. Deliberately not a BranchTransfer: that moves
// saleable IN_STOCK pieces between branches, this moves non-saleable ones to be inspected. Statuses:
// DRAFT -> IN_TRANSIT (send) -> RECEIVED (HO has received every piece) | CANCELLED (draft only).
model RepairTransfer {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  transferNumber String
  fromBranchId   String
  fromBranch     Branch    @relation("RepairTransferFrom", fields: [fromBranchId, companyId], references: [id, companyId], onDelete: Restrict)
  toBranchId     String
  toBranch       Branch    @relation("RepairTransferTo", fields: [toBranchId, companyId], references: [id, companyId], onDelete: Restrict)
  status         String    @default("DRAFT")
  reason         String?
  remarks        String?
  createdById    String
  sentById       String?
  sentAt         DateTime?
  receivedById   String?
  receivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items RepairTransferItem[]

  @@unique([companyId, transferNumber])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("repair_transfers")
}

model RepairTransferItem {
  id           String         @id @default(cuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  transferId   String
  transfer     RepairTransfer @relation(fields: [transferId, companyId], references: [id, companyId], onDelete: Restrict)
  repairCaseId String
  repairCase   RepairCase     @relation(fields: [repairCaseId, companyId], references: [id, companyId], onDelete: Restrict)
  // Set when Head Office physically took this piece in — an item with no receivedAt is still in transit.
  receivedAt   DateTime?
  receivedById String?

  @@unique([transferId, repairCaseId])
  @@index([companyId])
  @@index([repairCaseId])
  @@map("repair_transfer_items")
}

// True retagging: the piece's specification changed, so it gets a NEW tag number and the OLD tag becomes RETAGGED
// (it never disappears). A tag can be retagged once (unique old) and can be the product of one retag (unique new).
model TagRetag {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  retagNumber  String
  oldTagId     String
  oldTag       JewelryTag  @relation("RetagOld", fields: [oldTagId, companyId], references: [id, companyId], onDelete: Restrict)
  newTagId     String
  newTag       JewelryTag  @relation("RetagNew", fields: [newTagId, companyId], references: [id, companyId], onDelete: Restrict)
  repairCaseId String?
  repairCase   RepairCase? @relation(fields: [repairCaseId, companyId], references: [id, companyId], onDelete: Restrict)
  branchId     String
  branch       Branch      @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  reason       String
  oldDetails   Json
  newDetails   Json
  retaggedById String
  approvedById String
  approvedAt   DateTime    @default(now())
  remarks      String?
  createdAt    DateTime    @default(now())

  @@unique([companyId, retagNumber])
  @@unique([oldTagId, companyId])
  @@unique([newTagId, companyId])
  @@unique([repairCaseId, companyId])
  @@index([companyId])
  @@map("tag_retags")
}
