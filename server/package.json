{
  "name": "@sea-erp/server",
  "version": "1.0.0",
  "description": "SEA ERP Backend Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json",
    "start": "node -r dotenv/config dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "ts-node --require dotenv/config --project tsconfig.seed.json prisma/seed.ts",
    "reset:passwords": "ts-node --require dotenv/config scripts/reset-password.ts",
    "print:test": "ts-node --require dotenv/config scripts/testPrintTag.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:test:migrate": "node scripts/db-test-migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "company:provision": "ts-node --require dotenv/config scripts/provision-company.ts",
    "test:rls": "node scripts/test-rls.js",
    "audit:tenant": "ts-node scripts/tenant-audit.ts --strict",
    "db:secure": "prisma db execute --file prisma/db-secure.sql --schema prisma/schema.prisma",
    "start:prod": "node scripts/start-prod.js",
    "deploy:db": "powershell -ExecutionPolicy Bypass -File scripts/deploy-db.ps1"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "serialport": "^12.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
