# =============================================
# TRIVO ERP - Production Environment (staging on e2e-server)
# Copy to server/.env.production and fill in the placeholders.
# NEVER commit the filled-in file — .env.production stays out of git.
# =============================================

NODE_ENV=production
PORT=3001
# Reverse-proxy hops in front of the API (nginx = 1). Without this, every company's users share ONE rate-limit bucket.
TRUST_PROXY=1
# Per-IP requests per 15 min for the whole API. A shop's counters share one public IP — size for the busiest office.
API_RATE_LIMIT_MAX=3000
# Login/refresh attempts per IP per 15 min (brute-force defence). Shops share one IP: size for people signing in together.
AUTH_RATE_LIMIT_MAX=60
CLIENT_URL=http://YOUR_SERVER_IP_OR_DOMAIN

# Database — THREE identities (see server/prisma/production-rls-roles.sql). The API needs the first two:
#   DATABASE_URL           trivo_runtime  — the app role: no ownership, no BYPASSRLS, tables FORCE row-level security
#   PLATFORM_DATABASE_URL  trivo_platform — BYPASSRLS DML, used only for provisioning/operator/platform audit
#   OWNER_DATABASE_URL     trivo_owner    — DDL, used by `prisma migrate deploy` + `npm run db:secure` only (deploy job, not the API)
# The API REFUSES TO START in production if DATABASE_URL is a superuser / table owner / BYPASSRLS role.
# Add sslmode=require (or verify-full&sslrootcert=...) when Postgres is not on the same private network.
DATABASE_URL="postgresql://trivo_runtime:CHANGE_ME_RUNTIME_PASSWORD@postgres:5432/trivo?schema=public&connection_limit=20&pool_timeout=10&connect_timeout=5"
PLATFORM_DATABASE_URL="postgresql://trivo_platform:CHANGE_ME_PLATFORM_PASSWORD@postgres:5432/trivo?schema=public&connection_limit=5&pool_timeout=10&connect_timeout=5"
OWNER_DATABASE_URL="postgresql://trivo_owner:CHANGE_ME_OWNER_PASSWORD@postgres:5432/trivo?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD
POSTGRES_DB=trivo

# Operator API key for POST /api/v1/platform/* (company registration). At least 32 random characters.
TRIVO_PLATFORM_API_KEY=CHANGE_ME_32_CHAR_MINIMUM_OPERATOR_KEY

# Redis — service name, not localhost
REDIS_URL=redis://redis:6379

# JWT — generate real secrets, e.g. `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME_32_CHAR_MINIMUM_SECRET
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=CHANGE_ME_32_CHAR_MINIMUM_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# File storage — Cloudflare R2 (S3-compatible; the `minio` SDK client talks to it
# the same way it talks to a local MinIO instance, just point it elsewhere).
# Endpoint host only, no scheme — e.g. <ACCOUNT_ID>.r2.cloudflarestorage.com
MINIO_ENDPOINT=CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
MINIO_PORT=443
MINIO_ACCESS_KEY=CHANGE_ME_R2_ACCESS_KEY_ID
MINIO_SECRET_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
MINIO_BUCKET_NAME=CHANGE_ME_R2_BUCKET_NAME
MINIO_USE_SSL=true

# Email (SMTP) — optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# SMS Gateway — optional
SMS_API_KEY=
SMS_SENDER_ID=

# Metal Rate API — optional
METAL_RATE_API_URL=
METAL_RATE_API_KEY=

# (Devices are company-owned HardwareDevice rows; there is no process-wide scale/RFID setting.)
