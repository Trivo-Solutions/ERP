# Non-secret settings. They may instead live in %LOCALAPPDATA%\TrivoCameraBridge\bridge.config.json (written by
# `node dist/index.js provision`); real environment variables override the file. The station credential is NOT
# configured here or in that file - it is stored with Windows DPAPI (see OPERATIONS.md).
TRIVO_API_URL=https://erp.example.com
STATION_ID=
# mock (default in development, REQUIRED to be stated in production) | sony (needs the Sony helper + SDK installed on the station; see docs/SONY_HELPER_PROTOCOL.md)
# | webcam (Windows laptop / USB cameras; needs native/webcam/trivo-webcam-helper.exe, built by scripts/build-webcam.ps1; see docs/WEBCAM_HELPER_PROTOCOL.md)
# | auto (webcam + Sony listed; choose with `select-camera <id>` when several cameras exist)
CAMERA_PROVIDER=mock
# BRIDGE_PORT=9102
# LOG_LEVEL=info
# CAPTURE_TIMEOUT_MS=15000
# BRIDGE_TEMP_DIR=
# BRIDGE_TEMP_MAX_MB=200
# Provider-specific (validated by the provider), e.g. for sony: CAMERA_OPT_MODEL, CAMERA_OPT_DEVICE_ID, CAMERA_OPT_CONNECTION=usb|network, CAMERA_OPT_HELPER_PATH
