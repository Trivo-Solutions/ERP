# Copy this file to .env on the counter PC and fill in the real values.

# The exact name of the printer as Windows knows it (Control Panel > Devices and Printers,
# or run `Get-Printer` in PowerShell). Must already be installed — this agent doesn't install
# drivers, it only writes to an existing queue.
PRINTER_NAME="TSC TTP-244 Pro"

# Port the agent listens on, loopback-only (127.0.0.1). Change only if 9101 conflicts with
# something else already running on this PC.
PRINT_AGENT_PORT=9101

# Origin(s) the web app is served from, so the browser's CORS preflight succeeds. "*" is fine
# for v1 since the agent only ever listens on 127.0.0.1 regardless of this setting — narrow it
# if that assumption ever changes.
ALLOWED_ORIGIN=*
